{"version":3,"kind":"Article","sha256":"006a9d63a21719dc104d2da8f84eb54ce29c0965296c5799ec3a6059b26c6cd9","slug":"index3","location":"/04_Government/getting_started/Harvest/index3.md","dependencies":[],"frontmatter":{"title":"1. Active Modulation and Re-Surface Protocols","content_includes_title":true,"numbering":{"title":{"offset":3}},"exports":[{"format":"md","filename":"index3.md","url":"/Documents/build/index3-e650011a6653c87357c93f39f65831ec.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"To bring an Ag (silver) retroauricular injection site back to the surface after it has gone “deep”—referring to the migration or deep placement of silver nanoparticles or electrodes in a neural interface—you must utilize active modulation and electrochemical gradient management.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qU4a0lVjCU"}],"key":"RpIZOvQ96V"},{"type":"heading","depth":1,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1. Active Modulation and Re-Surface Protocols","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mj8Lya8xb3"}],"identifier":"id-1-active-modulation-and-re-surface-protocols","label":"1. Active Modulation and Re-Surface Protocols","html_id":"id-1-active-modulation-and-re-surface-protocols","implicit":true,"key":"ZfyOqc7Z2Y"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":4,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Electrophoretic Migration: If the Ag nanoparticles (AgNPs) have migrated too deep into the middle or inner ear compartments, applying a controlled external electric field can induce electrophoretic movement to pull charged particles back toward the primary interface site.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"sHMjJ6KpJb"}],"key":"EP1bpjofPy"}],"key":"GasIT2ebXg"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Pressure-Equalization (Borehole Technique): To relieve deep internal pressure that may be driving the injection further into the tissue, a secondary borehole or pressure-equalization tube can be placed in the tympanic membrane. This facilitates the “surfacing” of fluid and suspended particles by equalizing the barotrauma.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"AD7PQinfmP"}],"key":"cktVm0hAme"}],"key":"a0QdZGgfVE"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Vascular Remodeling Synchronization: In neural implants, vascular remodeling in shallow layers often precedes deeper recovery. By timing your interface “re-surfacing” with the peak of shallow angiogenesis (typically within the first two weeks), you can leverage the natural upward movement of the healing tissue front.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"HbQHM3o14a"}],"key":"fPaVWfUoLW"}],"key":"yi8cJXtrvL"}],"key":"cWX9PM1BHN"},{"type":"heading","depth":1,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"2. Implementation of “Shallow” Mode in Go/NESD","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"nYhQFLDoL1"}],"identifier":"id-2-implementation-of-shallow-mode-in-go-nesd","label":"2. Implementation of “Shallow” Mode in Go/NESD","html_id":"id-2-implementation-of-shallow-mode-in-go-nesd","implicit":true,"key":"SPDfKQvQsS"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"From the software and control perspective (your Go-service/NESD stack), bringing the interface “back to the surface” involves a Neural Veto and a Threshold Reset:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"N3potrysRv"}],"key":"umaiINSELq"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":10,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Command “Cortana, Surface”: Trigger a manual override that instructs the Envoy Proxy to prune all deep-layer data packets (Layers V and VI) and lock focus strictly on Layer I and the upper cortical layers.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"T7qdwm4ITG"}],"key":"sMqUiftHZ9"}],"key":"PAaaDh8l7t"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Recalibrate Opacity: Reset the OpacityCap to a minimal value (e.g., 0.15) to collapse the deep hyperspectral bubble into a shallow magnetoreceptive aura.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"kJUbT3h2u7"}],"key":"PxaMp4fhlp"}],"key":"T1MjI1mnvV"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sub-Threshold Haptic Tether: Increase the frequency of the MEG-fiber’s physical thrum on the skin. This physical grounding forces the brain’s focus back to the “surface” (the skin-interface boundary) and away from the deep internal data stream.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"AdTVwPb5b4"}],"key":"xZWKyv9NzH"}],"key":"r0KwWAYaix"}],"key":"EEq9bP1UfE"},{"type":"heading","depth":1,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"3. Safety and Maintenance","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"FhnJyuyiCL"}],"identifier":"id-3-safety-and-maintenance","label":"3. Safety and Maintenance","html_id":"id-3-safety-and-maintenance","implicit":true,"key":"xWIXAb9zVs"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Avoid Massage: Do not massage the retroauricular site, as this can cause irreversible irritation and drive the silver deeper into the neural tissue.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"jIoKA9KVNO"}],"key":"usVxS29aGV"}],"key":"laagdw50ZW"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Aseptic Debridement: If the “deep” placement is causing a foreign body reaction or inflammation, surgical debridement followed by antibiotic therapy may be required to physically retrieve the material from the deeper compartments.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"TgH00WDfpg"}],"key":"JvQGsjRENF"}],"key":"UFTEEe2EZJ"}],"key":"F2vxjg22w8"}],"key":"TGBbN2HGWG"}],"key":"uwxn7Uh41a"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"A Pluto.jl notebook","url":"/index2-1","group":"Harvest"},"next":{"title":"README","url":"/readme-51","group":"Phase1"}}},"domain":"http://localhost:3000"}