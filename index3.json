{"version":3,"kind":"Article","sha256":"006a9d63a21719dc104d2da8f84eb54ce29c0965296c5799ec3a6059b26c6cd9","slug":"index3","location":"/04_Government/getting_started/Harvest/index3.md","dependencies":[],"frontmatter":{"title":"1. Active Modulation and Re-Surface Protocols","content_includes_title":true,"numbering":{"title":{"offset":3}},"exports":[{"format":"md","filename":"index3.md","url":"/Documents/build/index3-73eea21fb240768e1ff7d452f54f123d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"To bring an Ag (silver) retroauricular injection site back to the surface after it has gone “deep”—referring to the migration or deep placement of silver nanoparticles or electrodes in a neural interface—you must utilize active modulation and electrochemical gradient management.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xLKzk48v4g"}],"key":"sAHWCy2BoD"},{"type":"heading","depth":1,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1. Active Modulation and Re-Surface Protocols","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mnMbjbEHaF"}],"identifier":"id-1-active-modulation-and-re-surface-protocols","label":"1. Active Modulation and Re-Surface Protocols","html_id":"id-1-active-modulation-and-re-surface-protocols","implicit":true,"key":"pC7cSmXxkt"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":4,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Electrophoretic Migration: If the Ag nanoparticles (AgNPs) have migrated too deep into the middle or inner ear compartments, applying a controlled external electric field can induce electrophoretic movement to pull charged particles back toward the primary interface site.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"lJHof7SXkU"}],"key":"FVJIDvdSzD"}],"key":"LaMqr72cFp"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Pressure-Equalization (Borehole Technique): To relieve deep internal pressure that may be driving the injection further into the tissue, a secondary borehole or pressure-equalization tube can be placed in the tympanic membrane. This facilitates the “surfacing” of fluid and suspended particles by equalizing the barotrauma.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"GtuthkG32G"}],"key":"xvMHeu3CL0"}],"key":"c5EyjksgTN"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Vascular Remodeling Synchronization: In neural implants, vascular remodeling in shallow layers often precedes deeper recovery. By timing your interface “re-surfacing” with the peak of shallow angiogenesis (typically within the first two weeks), you can leverage the natural upward movement of the healing tissue front.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"rrmzt479ct"}],"key":"WPl0KW5dqQ"}],"key":"eu3RbuSzvZ"}],"key":"CrBDdLKhku"},{"type":"heading","depth":1,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"2. Implementation of “Shallow” Mode in Go/NESD","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"XnORdoQtzI"}],"identifier":"id-2-implementation-of-shallow-mode-in-go-nesd","label":"2. Implementation of “Shallow” Mode in Go/NESD","html_id":"id-2-implementation-of-shallow-mode-in-go-nesd","implicit":true,"key":"AADNMZZ0h9"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"From the software and control perspective (your Go-service/NESD stack), bringing the interface “back to the surface” involves a Neural Veto and a Threshold Reset:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"AXpf9oD3cV"}],"key":"t6ikjrr2ho"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":10,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Command “Cortana, Surface”: Trigger a manual override that instructs the Envoy Proxy to prune all deep-layer data packets (Layers V and VI) and lock focus strictly on Layer I and the upper cortical layers.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"AbNssS8v2O"}],"key":"mAL1ErBnR8"}],"key":"TdbAJXuYij"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Recalibrate Opacity: Reset the OpacityCap to a minimal value (e.g., 0.15) to collapse the deep hyperspectral bubble into a shallow magnetoreceptive aura.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"e8127EvTfK"}],"key":"KpBIHEqWGM"}],"key":"ygUUi2Fh4D"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sub-Threshold Haptic Tether: Increase the frequency of the MEG-fiber’s physical thrum on the skin. This physical grounding forces the brain’s focus back to the “surface” (the skin-interface boundary) and away from the deep internal data stream.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"orM8Qfa1y5"}],"key":"p7ZpQXJwQt"}],"key":"iSmm8CyRQG"}],"key":"FYl4Wwjy8I"},{"type":"heading","depth":1,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"3. Safety and Maintenance","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"b7fsEfcNe4"}],"identifier":"id-3-safety-and-maintenance","label":"3. Safety and Maintenance","html_id":"id-3-safety-and-maintenance","implicit":true,"key":"KB2MM5vwFV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Avoid Massage: Do not massage the retroauricular site, as this can cause irreversible irritation and drive the silver deeper into the neural tissue.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"wR3qJPAcPl"}],"key":"YYai2LQlIF"}],"key":"O1CMkLASiU"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Aseptic Debridement: If the “deep” placement is causing a foreign body reaction or inflammation, surgical debridement followed by antibiotic therapy may be required to physically retrieve the material from the deeper compartments.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"g0Wxnt1BPn"}],"key":"lNxLN19vNU"}],"key":"x8tazPb4lj"}],"key":"TnsPAJIxtx"}],"key":"lEmJI1lfYL"}],"key":"VnPRAHR6WW"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"A Pluto.jl notebook","url":"/index2-1","group":"Harvest"},"next":{"title":"README","url":"/readme-65","group":"Phase1"}}},"domain":"http://localhost:3000"}