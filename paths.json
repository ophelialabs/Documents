:{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"s0fl5j54xV"}],"key":"eWUqcPhVVr"}],"key":"mVorXntuDP"}],"key":"SGxmbihuzG"}],"key":"uOwAtZ7TOV"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify Users and Sessions:\nTo effectively map a user’s path, you need to associate runs with a specific user_id or session_id within the application’s runtime configuration. This is crucial for filtering and analyzing individual user journeys within the observability platform’s dashboards.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"XRhAMuTiUQ"}],"key":"ajK9q5pCrG"}],"key":"fPWUmqk0DT"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Visualize the Path: Once data is being collected, the observability platform’s UI will present the execution flow visually. You can see each step of the agent’s run, including:","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"gmgmGcIjbt"}],"key":"rU7KxlwWW0"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":19,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Initial user input","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"urOgA6a5Es"}],"key":"rMprQhbRli"}],"key":"l2tj98qRN7"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Model interactions (LLM calls)","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"KJtUGpyLql"}],"key":"hJ38T