y":"hgTsqjKW07"},{"type":"heading","depth":3,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Prerequisites","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"xC6ku5LaJx"}],"identifier":"prerequisites","label":"Prerequisites","html_id":"prerequisites","implicit":true,"key":"aYZSTNXHhW"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Install langchain, langgraph, and the relevant model integration package (e.g., langchain-openai):","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"KLdgLCU0dD"}],"key":"xpDOyAJNgV"},{"type":"code","lang":"","value":"pip install langchain langgraph langchain-openai","position":{"start":{"line":46,"column":1},"end":{"line":48,"column":1}},"key":"EmJR41HNRW"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Set your API key as an environment variable (e.g., OPENAI_API_KEY).","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"SQpGqoKgAA"}],"key":"hWEl2aQiGd"},{"type":"heading","depth":3,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Step-by-Step Implementation","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"DqK1mCEPBE"}],"identifier":"step-by-step-implementation","label":"Step-by-Step Implementation","html_id":"step-by-step-implementation","implicit":true,"key":"YzQs3oQH7R"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":53,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the Graph State using a TypedDict to hold conversation history and a list for tracking the user’s path.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"DdD0H5XB8s"}],"key":"geOfQXQXJL"}],"key":"FJW80o5z9L"},{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Initialize an InMemoryStore for persistence across sessions, noting that a database is better for production.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"UZEUQEyVIK"}],"key":"ci7uZOHxML"}],"key":"PweZnsOeMT"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define nodes (steps) where each function accesses the InMemoryStore via get_store() to log actions with a user_id and namespace.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"GSPXNdJHRz"}],"key":"ckF6D7LDdB"}],"key":"pHus4fijmP"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Build the graph using StateGraph, add the nodes, connect them with edges, and compile it, injecting the InMemoryStore. A MemorySaver can be used for short-term memory.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"L4UaT0hNP0"}],"key":"b4t28l7aEl"}],"key":"cq9LmU39YS"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Run the compiled graph, providing a unique user_id in the config’s configurable section.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"j1dtljAn3R"}],"key":"HEYOPgnOVF"}],"key":"p3ydz1Po6e"}],"key":"vOgRdWIiE2"},{"type":"heading","depth":3,"position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Retrieving and Visualizing the Path","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"rHuCL77YGf"}],"identifier":"retrieving-and-visualizing-the-path","label":"Retrieving and Visualizing the Path","html_id":"retrieving-and-visualizing-the-path","implicit":true,"key":"D8hLNto1IR"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"After running, query the InMemoryStore with the user_id to retrieve logged actions and reconstruct the path. This data can be used for visualization, potentially with tools like LangSmith.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"y3mXouImMw"}],"key":"J78K7v3aD4"}],"key":"rEXYv9rPBN"}],"key":"OYg4kaGdX0"},{"type":"thematicBreak","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"k1jVN1yxiI"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"tracking a user’s path (long-term context) in LangChain infrastructure is primarily achieved using InMemoryStore within the LangGraph framework. This setup namespaces memories by user_id to ensure isolation and persistence across different interaction threads.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"NZ6pzCrx96"}],"key":"PxTKmNkOHr"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Initialize the Infrastructure\nTo start, you must instantiate the InMemoryStore and a checkpointer. The checkpointer manages short-term thread state, while the store manages long-term user data.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"yOcXx1X40O"}],"key":"QVAsKC8aeG"}],"key":"ZZgsegMXAi"}],"key":"f2i4KjBP42"},{"type":"code","lang":"","value":"from langgraph.store.memory import InMemoryStore\nfrom langgraph.checkpoint.memory import MemorySaver\n\n# The Store holds cross-thread user data\nstore = InMemoryStore()\n\n# The Checkpointer holds single-thread state\ncheckpointer = MemorySaver()","position":{"start":{"line":67,"column":1},"end":{"line":76,"column":1}},"key":"F5ux9arsW4"},{"type":"list","ordered":true,"start":2,"spread":false,"position":{"start":{"line":78,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the User Path (Namespacing)\nYou can map a user’s “path” by organizing data into hierarchical namespaces. A common pattern is (“users”, user_id, “history”).\nNamespace: A tuple used to group related data (e.g., (“users”, “user_123”)).\nKey: A unique identifier within that namespace (e.g., “current_step”).","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"Ll8T3itsRQ"}],"key":"yGucketdLR"}],"key":"eu7mbuYJVj"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Record and Update the User Path\nIn your graph nodes, you can update the user’s progress or path using the store.put() method.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"p2CF9Zb4fE"}],"key":"PD9gNMz6oo"}],"key":"pLN8Epbj8O"}],"key":"Yc5pOF2ufx"},{"type":"code","lang":"","value":"def update_user_path(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    namespace = (\"users\", user_id, \"path\")\n    \n    # Store the user's current step or \"path\" metadata\n    store.put(namespace, \"latest_node\", {\"node\": \"onboarding_step_2\"})\n    return \"User path updated.\"","position":{"start":{"line":85,"column":1},"end":{"line":93,"column":1}},"key":"vx6MBZTLBX"},{"type":"list","ordered":true,"start":4,"spread":false,"position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Retrieve the User Path\nTo show or act upon the user’s path in subsequent sessions, use store.get() or ","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"f0aimDCeGo"},{"type":"link","url":"http://store.search","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"store.search","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"CLxhUcmdYD"}],"urlSource":"http://store.search","key":"O9FkoWhebo"},{"type":"text","value":"().","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"uJjcEWpbv1"}],"key":"Z64QwMFFze"}],"key":"kPjrm0IFwe"}],"key":"UTSyFTUgRP"},{"type":"code","lang":"","value":"def get_user_path(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    namespace = (\"users\", user_id, \"path\")\n    \n    # Retrieve the user's path data\n    path_data = store.get(namespace, \"latest_node\")\n    return path_data","position":{"start":{"line":98,"column":1},"end":{"line":106,"column":1}},"key":"XTzXZrFna5"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"or visualize the current context based on the stored path:","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"SXtjgJqb0d"}],"key":"j28QgKE94b"},{"type":"code","lang":"","value":"def get_current_context(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    # Retrieve the user's stored path from the in-memory store\n    user_path = store.get((\"users\", user_id, \"path\"), \"latest_node\")\n    \n    if user_path:\n        print(f\"User is currently at: {user_path.value['node']}\")","position":{"start":{"line":108,"column":1},"end":{"line":116,"column":1}},"key":"xu5JZWgnX5"},{"type":"list","ordered":true,"start":5,"spread":false,"position":{"start":{"line":118,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":118,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Compile the Graph\nThe graph must be compiled with both the checkpointer and the store to enable these features.","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"K1hbzB0WYs"}],"key":"hQQOamGEHD"}],"key":"evU3ZPzNjz"}],"key":"iLHgV5ypAA"},{"type":"code","lang":"","value":"# Compile the workflow including the store\napp = workflow.compile(checkpointer=checkpointer, store=store)\n\n# Invoke with specific user_id in the config\nconfig = {\"configurable\": {\"thread_id\": \"thread_abc\", \"user_id\": \"user_123\"}}\napp.invoke({\"messages\": [...]}, config=config)","position":{"start":{"line":120,"column":1},"end":{"line":127,"column":1}},"key":"UxJ1WxCFyf"},{"type":"heading","depth":2,"position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"Key Considerations:","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"tOEmUDS8mm"}],"identifier":"key-considerations","label":"Key Considerations:","html_id":"key-considerations","implicit":true,"key":"goYpat4UKp"},{"type":"list","ordered":false,"spread":f