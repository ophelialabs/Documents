"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the Infrastructure Map (StateGraph)\nInstead of a linear chain, use a StateGraph to define your nodes (infrastructure components) and edges (the paths between them).","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"jTFuDyITZz"}],"key":"I1qW0bddek"}],"key":"HVdnT0CJCN"}],"key":"PWvQ8mUjv3"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Nodes: Functions representing specific infrastructure tasks, such as database lookups, API calls, or LLM reasoning.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"u3afulhoRj"}],"key":"a7Xe77Ktgs"}],"key":"NVyjtTqQ5T"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Edges: Defined routes that dictate how a user moves from one node to another based on logic or LLM decisions.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"kDnskZVhOV"}],"key":"Yt2Ct16o5I"}],"key":"oiGmsVO6uw"}],"key":"UKhkBkTU71"},{"type":"list","ordered":true,"start":2,"spread":false,"position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Implement User Persistence\nTo track a specific user’s path across multiple sessions or threads, integrate a Checkpointer.","position":{"start":{"line":31,"column":1},"end":{"line":31,"