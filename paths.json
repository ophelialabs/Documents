"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the Infrastructure Map (StateGraph)\nInstead of a linear chain, use a StateGraph to define your nodes (infrastructure components) and edges (the paths between them).","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"N13vI9euTh"}],"key":"pIFK5obpW0"}],"key":"gR3e3vnMoA"}],"key":"C54OSreb8t"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Nodes: Functions representing specific infrastructure tasks, such as database lookups, API calls, or LLM reasoning.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"V7fl6vX6tv"}],"key":"esA0B1tPmH"}],"key":"nPZ6HdiFsp"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Edges: Defined routes that dictate how a user moves from one node to another based on logic or LLM decisions.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"NbdSA5CnHz"}],"key":"wdSpBQBD7Q"}],"key":"y0o1bUGkOr"}],"key":"h6zbjoKYfu"},{"type":"list","ordered":true,"start":2,"spread":false,"position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Implement User Persistence\nTo track a specific user’s path across multiple sessions or threads, integrate a Checkpointer.","position":{"start":{"line":31,"column":1},"end":{"line":31,"