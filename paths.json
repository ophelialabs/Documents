y and a list for tracking the user’s path.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"L7I0f1QeFO"}],"key":"luqHDqSzkF"}],"key":"TAVp5IyjhY"},{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Initialize an InMemoryStore for persistence across sessions, noting that a database is better for production.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"sash3OCkUm"}],"key":"lXJvm03yqP"}],"key":"WjzEMc1dhh"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define nodes (steps) where each function accesses the InMemoryStore via get_store() to log actions with a user_id and namespace.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"PzMag3FlWf"}],"key":"uHuMQIBNYY"}],"key":"DHNoeHWMxn"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Build the graph using StateGraph, add the nodes, connect them with edges, and compile it, injecting the InMemoryStore. A MemorySaver can be used for short-term memory.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"b6tiO8XlN1"}],"key":"dJzTsmJ5Zp"}],"key":"v63apX97MW"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Run the compiled graph, providing a unique user_id in the config’s configurable section.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"p7m2YEgx8Y"}],"key":"euYtOFZBiT"}],"key":"Oj3noYPi3z"}],"key":"XA2Y6nPTG2"},{"type":"heading","depth":3,"position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Retrieving and Visualizing the Path","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"HaDf4R5UmM"}],"identifier":"retrieving-and-visualizing-the-path","label":"Retrieving and Visualizing the Path","html_id":"retrieving-and-visualizing-the-path","implicit":true,"key":"MDZMAKk2ku"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"After running, query the InMemoryStore with the user_id to retrieve logged actions and reconstruct the path. This data can be used for visualization, potentially with tools like LangSmith.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"mxzyKkXvd3"}],"key":"y4AuQ2yVpv"}],"key":"JEVPqBWaTA"}],"key":"QM01977ZMB"},{"type":"thematicBreak","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"d0Grbi24Qo"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"tracking a user’s path (long-term context) in LangChain infrastructure is primarily achieved using InMemoryStore within the LangGraph framework. This setup namespaces memories by user_id to ensure isolation and persistence across different interaction threads.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"xBACWIsnsM"}],"key":"V3LN4yYUqj"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Initialize the Infrastructure\nTo start, you must instantiate the InMemoryStore and a checkpointer. The checkpointer manages short-term thread state, while the store manages long-term user data.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"SOvCliGV8q"}],"key":"mv8JNx41mv"}],"key":"Fhv9JeQRQX"}],"key":"HMXsO5qXeK"},{"type":"code","lang":"","value":"from langgraph.store.memory import InMemoryStore\nfrom langgraph.checkpoint.memory import MemorySaver\n\n# The Store holds cross-thread user data\nstore = InMemoryStore()\n\n# The Checkpointer holds single-thread state\ncheckpointer = MemorySaver()","position":{"start":{"line":67,"column":1},"end":{"line":76,"column":1}},"key":"EHzySPqF4T"},{"type":"list","ordered":true,"start":2,"spread":false,"position":{"start":{"line":78,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the User Path (Namespacing)\nYou can map a user’s “path” by organizing data into hierarchical namespaces. A common pattern is (“users”, user_id, “history”).\nNamespace: A tuple used to group related data (e.g., (“users”, “user_123”)).\nKey: A unique identifier within that namespace (e.g., “current_step”).","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"IKfOI8MPPA"}],"key":"p6lQKHQh3m"}],"key":"Fx6lgbYFCU"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Record and Update the User Path\nIn your graph nodes, you can update the user’s progress or path using the store.put() method.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"rJoNoJfeEO"}],"key":"v2ezTd5zWH"}],"key":"fSBL7DoiIB"}],"key":"EjCohHhIRW"},{"type":"code","lang":"","value":"def update_user_path(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    namespace = (\"users\", user_id, \"path\")\n    \n    # Store the user's current step or \"path\" metadata\n    store.put(namespace, \"latest_node\", {\"node\": \"onboarding_step_2\"})\n    return \"User path updated.\"","position":{"start":{"line":85,"column":1},"end":{"line":93,"column":1}},"key":"zLKAeZ7LaB"},{"type":"list","ordered":true,"start":4,"spread":false,"position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Retrieve the User Path\nTo show or act upon the user’s path in subsequent sessions, use store.get() or ","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"rIBbtKTpyR"},{"type":"link","url":"http://store.search","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"store.search","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"Wl79NBh1jg"}],"urlSource":"http://store.search","key":"oU79kUNjOy"},{"type":"text","value":"().","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"blm5X7Cwr0"}],"key":"Z7lkUPrzqo"}],"key":"E2bd5x4bgR"}],"key":"HxylvYY9kT"},{"type":"code","lang":"","value":"def get_user_path(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    namespace = (\"users\", user_id, \"path\")\n    \n    # Retrieve the user's path data\n    path_data = store.get(namespace, \"latest_node\")\n    return path_data","position":{"start":{"line":98,"column":1},"end":{"line":106,"column":1}},"key":"lqOf9VRLcA"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"or visualize the current context based on the stored path:","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"TWAEDpaZJ4"}],"key":"TROOHKjCS5"},{"type":"code","lang":"","value":"def get_current_context(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    # Retrieve the user's stored path from the in-memory store\n    user_path = store.get((\"users\", user_id, \"path\"), \"latest_node\")\n    \n    if user_path:\n        print(f\"User is currently at: {user_path.value['node']}\")","position":{"start":{"line":108,"column":1},"end":{"line":116,"column":1}},"key":"DokLO4qGhQ"},{"type":"list","ordered":true,"start":5,"spread":false,"position":{"start":{"line":118,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":118,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Compile the Graph\nThe graph must be compiled with both the checkpointer and the store to enable these features.","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"fEjichOAKM"}],"key":"uIHnj7zcIk"}],"key":"BBF9xLD4tv"}],"key":"Tor4K3FZGd"},{"type":"code","lang":"","value":"# Compile the workflow including the store\napp = workflow.compile(checkpointer=checkpointer, store=store)\n\n# Invoke with specific user_id in the config\nconfig = {\"configurable\": {\"thread_id\": \"thread_abc\", \"user_id\": \"user_123\"}}\napp.invoke({\"messages\": [...]}, config=config)","position":{"start":{"line":120,"column":1},"end":{"line":127,"column":1}},"key":"FO6JKA3oKH"},{"type":"heading","depth":2,"position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"Key Considerations:","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"Ao6dkZ6T4b"}],"identifier":"key-considerations","label":"Key Considerations:","html_id":"key-considerations","implicit":true,"key":"WjgYPD0it6"},{"type":"list","ordered":false,"spread":f