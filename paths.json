y":"lt3AVYRRst"},{"type":"heading","depth":3,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Prerequisites","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"QVo7dmGoEt"}],"identifier":"prerequisites","label":"Prerequisites","html_id":"prerequisites","implicit":true,"key":"lj01y6JePk"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Install langchain, langgraph, and the relevant model integration package (e.g., langchain-openai):","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"Mlg8jmMki8"}],"key":"wDgThAuq6S"},{"type":"code","lang":"","value":"pip install langchain langgraph langchain-openai","position":{"start":{"line":46,"column":1},"end":{"line":48,"column":1}},"key":"Sczf6X17tk"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Set your API key as an environment variable (e.g., OPENAI_API_KEY).","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"CGIaEXA23V"}],"key":"cuo0ujWuLL"},{"type":"heading","depth":3,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Step-by-Step Implementation","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"i7cZryTJ4A"}],"identifier":"step-by-step-implementation","label":"Step-by-Step Implementation","html_id":"step-by-step-implementation","implicit":true,"key":"cstBEaifvP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":53,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the Graph State using a TypedDict to hold conversation history and a list for tracking the user’s path.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"duWVJHY6uP"}],"key":"KOMJXOxAr7"}],"key":"TlxqJz2JXD"},{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Initialize an InMemoryStore for persistence across sessions, noting that a database is better for production.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"U3VLnSJ6gJ"}],"key":"kwyttgtvWb"}],"key":"MWAWJiC8k9"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define nodes (steps) where each function accesses the InMemoryStore via get_store() to log actions with a user_id and namespace.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"DED2KukjHN"}],"key":"i4UL6G5dLn"}],"key":"eTSzvWFzrz"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Build the graph using StateGraph, add the nodes, connect them with edges, and compile it, injecting the InMemoryStore. A MemorySaver can be used for short-term memory.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"TbGuASAakQ"}],"key":"lEcuHUw5oe"}],"key":"R1Dxjk0jrw"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Run the compiled graph, providing a unique user_id in the config’s configurable section.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"EEK2bWy3mY"}],"key":"lsh4qLTzrw"}],"key":"YVkMjVkNtX"}],"key":"FgUUyQXKeo"},{"type":"heading","depth":3,"position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Retrieving and Visualizing the Path","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"YMFcPGOlOA"}],"identifier":"retrieving-and-visualizing-the-path","label":"Retrieving and Visualizing the Path","html_id":"retrieving-and-visualizing-the-path","implicit":true,"key":"oKBWUVcLJK"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"After running, query the InMemoryStore with the user_id to retrieve logged actions and reconstruct the path. This data can be used for visualization, potentially with tools like LangSmith.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"nUUTMO18hT"}],"key":"OghSeeYmDi"}],"key":"ITOKpSA7Dx"}],"key":"E6uvO0sG4a"},{"type":"thematicBreak","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"b5j46DtZYM"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"tracking a user’s path (long-term context) in LangChain infrastructure is primarily achieved using InMemoryStore within the LangGraph framework. This setup namespaces memories by user_id to ensure isolation and persistence across different interaction threads.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"v9QQqex23Z"}],"key":"SGUgnMiXnf"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Initialize the Infrastructure\nTo start, you must instantiate the InMemoryStore and a checkpointer. The checkpointer manages short-term thread state, while the store manages long-term user data.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"MXViaNmh0Q"}],"key":"MUi956wwyo"}],"key":"tn4dYEqf7e"}],"key":"n2lFsz3Oey"},{"type":"code","lang":"","value":"from langgraph.store.memory import InMemoryStore\nfrom langgraph.checkpoint.memory import MemorySaver\n\n# The Store holds cross-thread user data\nstore = InMemoryStore()\n\n# The Checkpointer holds single-thread state\ncheckpointer = MemorySaver()","position":{"start":{"line":67,"column":1},"end":{"line":76,"column":1}},"key":"LbyriUOyNM"},{"type":"list","ordered":true,"start":2,"spread":false,"position":{"start":{"line":78,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the User Path (Namespacing)\nYou can map a user’s “path” by organizing data into hierarchical namespaces. A common pattern is (“users”, user_id, “history”).\nNamespace: A tuple used to group related data (e.g., (“users”, “user_123”)).\nKey: A unique identifier within that namespace (e.g., “current_step”).","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"uQ0Bq09e2B"}],"key":"QSdxDdi93n"}],"key":"ZQ4aUKeX3O"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Record and Update the User Path\nIn your graph nodes, you can update the user’s progress or path using the store.put() method.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"DTuBh6rEiy"}],"key":"vIXZZptnoV"}],"key":"vPs4lrDyCu"}],"key":"LSMG2Tqr45"},{"type":"code","lang":"","value":"def update_user_path(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    namespace = (\"users\", user_id, \"path\")\n    \n    # Store the user's current step or \"path\" metadata\n    store.put(namespace, \"latest_node\", {\"node\": \"onboarding_step_2\"})\n    return \"User path updated.\"","position":{"start":{"line":85,"column":1},"end":{"line":93,"column":1}},"key":"IbsJfAkXjk"},{"type":"list","ordered":true,"start":4,"spread":false,"position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Retrieve the User Path\nTo show or act upon the user’s path in subsequent sessions, use store.get() or ","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"EIHuyIpzP9"},{"type":"link","url":"http://store.search","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"store.search","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"KDBM5Mdagr"}],"urlSource":"http://store.search","key":"ERsPYi7Iee"},{"type":"text","value":"().","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"UJDsjNM0N8"}],"key":"tMRNlZOqPa"}],"key":"sj25EN0Fd7"}],"key":"HBS23OCIdb"},{"type":"code","lang":"","value":"def get_user_path(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    namespace = (\"users\", user_id, \"path\")\n    \n    # Retrieve the user's path data\n    path_data = store.get(namespace, \"latest_node\")\n    return path_data","position":{"start":{"line":98,"column":1},"end":{"line":106,"column":1}},"key":"mzvkKmFJU3"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"or visualize the current context based on the stored path:","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"rNrHMfqfd0"}],"key":"j6WtHTff4e"},{"type":"code","lang":"","value":"def get_current_context(state, config, store):\n    user_id = config[\"configurable\"].get(\"user_id\")\n    # Retrieve the user's stored path from the in-memory store\n    user_path = store.get((\"users\", user_id, \"path\"), \"latest_node\")\n    \n    if user_path:\n        print(f\"User is currently at: {user_path.value['node']}\")","position":{"start":{"line":108,"column":1},"end":{"line":116,"column":1}},"key":"QXmyNDr7Cy"},{"type":"list","ordered":true,"start":5,"spread":false,"position":{"start":{"line":118,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":118,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Compile the Graph\nThe graph must be compiled with both the checkpointer and the store to enable these features.","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"B5Ce2IVYKC"}],"key":"cCqNi7ue79"}],"key":"fHekfJ6BIN"}],"key":"KW0J2wDWh7"},{"type":"code","lang":"","value":"# Compile the workflow including the store\napp = workflow.compile(checkpointer=checkpointer, store=store)\n\n# Invoke with specific user_id in the config\nconfig = {\"configurable\": {\"thread_id\": \"thread_abc\", \"user_id\": \"user_123\"}}\napp.invoke({\"messages\": [...]}, config=config)","position":{"start":{"line":120,"column":1},"end":{"line":127,"column":1}},"key":"IRtSmeB1ZX"},{"type":"heading","depth":2,"position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"Key Considerations:","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"uG2EvsbF93"}],"identifier":"key-considerations","label":"Key Considerations:","html_id":"key-considerations","implicit":true,"key":"XEsw5R7Szw"},{"type":"list","ordered":false,"spread":f