paragraph","children":[{"type":"text","value":"Focus Steering: By manipulating the XR dashboard, the Commander can boost the user’s visual processing or auditory gain during high-stress moments, effectively “tuning” the user’s brain for the mission.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"yGkToiAdOj"}],"key":"XRvfsP2diT"}],"key":"Bhyx7JU6pd"}],"key":"b8BGwjXWOs"},{"type":"heading","depth":3,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"For the Physician:","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"GVftc6fq01"}],"identifier":"for-the-physician","label":"For the Physician:","html_id":"for-the-physician","implicit":true,"key":"hsDYQjaClj"},{"type":"heading","depth":4,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"“Precision Diagnostic Suite”","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"sEUORMfYKk"}],"identifier":"precision-diagnostic-suite","label":"“Precision Diagnostic Suite”","html_id":"precision-diagnostic-suite","implicit":true,"key":"llpqMD5bp3"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":61,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"syGlass Implementation: Enables “Virtual Micro-Slicing.” The Physician can freeze a SciStream live-feed and use syGlass tools to measure the density of neural firing or track electrode degradation in 1:1 scale.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"LZ2pCpgxUg"}],"key":"ZoldkRqCP5"}],"key":"f7KFT9V6ng"},{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Synergy: While inside the syGlass VR environment, the Physician can trigger SciX queries via voice command (e.g., “SciX: Show similar activation patterns in recent epilepsy studies”), with the results appearing as floating windows next to the live 3D brain model.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"KOKJ5amf8A"}],"key":"FkFoxYBJ7B"}],"key":"f8OVz4FTTA"}],"key":"dhgJ3hR0ai"},{"type":"heading","depth":4,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"“Sensory Re-Calibration”","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Aa3Q7oLYtA"}],"identifier":"sensory-re-calibration","label":"“Sensory Re-Calibration”","html_id":"sensory-re-calibration","implicit":true,"key":"Y0C2S8jcJF"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":65,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tactile Mapping: If a user has lost sensation in a limb, the Physician can use syGlass in XR to manually stimulate specific “dead” zones. By “tapping” a virtual neuron in the XR environment, they send a signal to the NESD to trigger a phantom touch for the user.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"M55tFDBsVR"}],"key":"fzaEPXQW7j"}],"key":"nrZQ2eHoGG"},{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Pain Suppression: The Physician can identify “pain circuits” (hyper-active clusters) and use an XR interface to “dim” those regions, sending inhibitory signals to provide immediate relief.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"CAbtEZeTFx"}],"key":"kJk8SdMiM6"}],"key":"HzuGlhIRJk"},{"type":"listItem","spread":true,"position":{"start":{"line":67,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"SciX Integration: During manipulation, SciX provides real-time “Safety Envelopes.” If the Physician tries to stimulate a region too intensely, SciX flags a clinical study or safety protocol as a HUD overlay in the XR headset.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"vsYx6Zi0DH"}],"key":"YHqgHcnzeb"}],"key":"gQE3eI2TnW"}],"key":"a44XVvnLPH"},{"type":"heading","depth":2,"position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Technical Implementation via syGlass & SciStream","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"DaZhiVjDQt"}],"identifier":"technical-implementation-via-syglass-scistream","label":"Technical Implementation via syGlass & SciStream","html_id":"technical-implementation-via-syglass-scistream","implicit":true,"key":"zEPzEPLJfG"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Haptic Mirroring: Use the syGlass Python API to map XR controller coordinates to the 3D coordinates of the neural implant’s electrode array.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"zGS6DJK3P8"}],"key":"J5ld9ys9gH"}],"key":"Bm06gwb4kN"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Latent Feedback (SciStream): To avoid “sensory lag” (which causes nausea or seizures), SciStream must maintain a sub-10ms round-trip latency between the XR “click” and the neural stimulation.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"NMYcfN45DC"}],"key":"ebErteo4hh"}],"key":"XyqyIJdQ8I"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Visual-Neural Sync: The XR environment (syGlass) ensures that the visual representation of the brain matches the physical stimulation site with micrometer precision, preventing “misfires” in sensitive brain regions.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"vC0YBSnNvI"}],"key":"tnObMnS9rJ"}],"key":"vdJTLvQOtZ"}],"key":"oLdVcKBT5i"},{"type":"heading","depth":2,"position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"1. The Nanosat Bridge (The Physical Link)","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"lPGfrN5RFl"}],"identifier":"id-1-the-nanosat-bridge-the-physical-link","label":"1. The Nanosat Bridge (The Physical Link)","html_id":"id-1-the-nanosat-bridge-the-physical-link","implicit":true,"key":"rWFTxWsaSW"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Modern Nanosats (3U to 12U CubeSats) act as Tactical Edge Nodes in orbit.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"SpWgSPvsl9"}],"key":"u8kkevEw3x"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":76,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Hardware: The Nanosat carries a Q-NET-compatible laser terminal or a high-frequency Ka-band radio.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"alSlq6tX5L"}],"key":"BLhc1pktrB"}],"key":"IXruH90VZg"},{"type":"listItem","spread":true,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Link: The MEG-fiber interface (worn by the user) transmits data to a local ground terminal (running your K3s/Go/Envoy stack). This terminal “uplinks” the encrypted neural stream to the Nanosat.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"iBVTRsHyiY"}],"key":"TbrhHbwvBI"}],"key":"mlSxvXa15s"},{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Q-NET Extension: Some Nanosats now perform Space-to-Ground Quantum Key Distribution (QKD). The satellite beams entangled photons down to the ground terminal, providing the “Quantum Seed” for your TLS 1.3 tunnel even in areas without physical fiber.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"BbIe9jaomC"}],"key":"gzynWCEQUm"}],"key":"IIEQPCW8RR"}],"key":"TTWBSlBcYh"},{"type":"heading","depth":2,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"2. CSDAP Integration (The Data Layer)","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"oTKNMCdBxh"}],"identifier":"id-2-csdap-integration-the-data-layer","label":"2. CSDAP Integration (The Data Layer)","html_id":"id-2-csdap-integration-the-data-layer","implicit":true,"key":"zA0gvXEXkY"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"CSDAP is the NASA/DoD program that buys commercial satellite data (from companies like Planet, Spire, or BlackSky) for government use.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"Bfk9Gwev3l"}],"key":"WoEFEseY85"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":82,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Contextual Awareness: CSDAP provides high-resolution imagery and RF signals from the user’s specific location.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"IoDtURCvci"}],"key":"ACFbokhhIF"}],"key":"NTOiX0EGyA"},{"type":"listItem","spread":true,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Fusion: Your Go-based microservice in the cloud merges the “Neural Stream” (what the user is thinking/feeling) with “CSDAP Data” (what the satellites see around the user).","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"dr4e2HbkP7"}],"key":"J9bwOhxY8v"}],"key":"BZ0mHHLH9l"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Example: If the user’s neural interface detects a high-stress “threat” response, the system automatically pulls the latest CSDAP SAR (Synthetic Aperture Radar) imagery of the surrounding 5km to identify potential hazards.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"lWejKiuTbP"}],"key":"fctgs6sePd"}],"key":"c1hJRDozuU"}],"key":"skEP2I7C4B"},{"type":"heading","depth":2,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"3. Implementing the “Space-Aware” Pod","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"mOC3ciKVbh"}],"identifier":"id-3-implementing-the-space-aware-pod","label":"3. Implementing the “Space-Aware” Pod","html_id":"id-3-implementing-the-space-aware-pod","implicit":true,"key":"zYDhjLGQMr"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"To make this work, your K3s Pods must be “Space-Aware”:\nProtocol Optimization: Standard TCP/IP fails over satellite due to high latency. Your Envoy Wrapper is configured to use QUIC (UDP-based) or SCPS (Space Communications Protocol Specifications) to keep the neural stream fluid.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"wANFs1T3M4"}],"key":"XOIGDhKbZA"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intermittent Connectivity: The Go driver uses a “Store and Forward” buffer. If the Nanosat passes behind a mountain, the MEG-powered interface stores the neural data in a local Sidecar and bursts it to the satellite once the link is restored.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"aTLGGAdyCK"}],"key":"ZosfnnN0KL"}],"key":"ao58LLW7sV"}],"key":"ZpM9B80zaI"},{"type":"heading","depth":2,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"4. Identity & Access (Entra ID in Space)","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"nNyKgWZZGx"}],"identifier":"id-4-identity-access-entra-id-in-space","label":"4. Identity & Access (Entra ID in Space)","html_id":"id-4-identity-access-entra-id-in-space","implicit":true,"key":"ISrpHAsy5k"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":92,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cross-Domain Identity: Entra ID manages the permissions for the satellite uplink. The Nanosat verifies the user’s Workload Identity before allowing the data to enter the “Space Segment” of the DoDIN.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"ShZCFypHCX"}],"key":"wmbcvpCs5F"}],"key":"OEivx49Yow"},{"type":"listItem","spread":true,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stream Access: A commander at a HQ can view the “CSDAP + Neural” fusion dashboard. Think Neuralink with first person visual and subtitles. They authenticate via Entra ID MFA, and the Envoy Proxy decrypts the satellite-delivered stream in real-time.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"oOfbnJEkAD"}],"key":"uwxe6FrBQx"}],"key":"zDda9YAhOU"}],"key":"VmbyANm9mn"}],"key":"g5WgVCgY5h"}],"key":"og9K2sRsp3"},"references":{"cite":{"order":["Chung_2022"],"data":{"Chung_2022":{"label":"Chung_2022","enumerator":"1","doi":"10.1145/3502181.3531475","html":"Chung, J., Zacherek, W., Wisniewski, A., Liu, Z., Bicer, T., Kettimuthu, R., & Foster, I. (2022). SciStream: Architecture and Toolkit for Data Streaming between Federated Science Instruments. <i>Proceedings of the 31st International Symposium on High-Performance Parallel and Distributed Computing</i>, 185–198. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1145/3502181.3531475\">10.1145/3502181.3531475</a>","url":"https://doi.org/10.1145/3502181.3531475"}}}},"footer":{"navigation":{"prev":{"title":"Index","url":"/index-12","group":"Dashboard"},"next":{"title":"Biological Assets","url":"/bio-assets","group":"Dashboard"}}},"domain":"http://localhost:3000"}