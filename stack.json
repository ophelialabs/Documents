:"paragraph","children":[{"type":"text","value":"Focus Steering: By manipulating the XR dashboard, the Commander can boost the user’s visual processing or auditory gain during high-stress moments, effectively “tuning” the user’s brain for the mission.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"KPbaR8GWVe"}],"key":"NWHhHNQNx0"}],"key":"AxYxGaoqE6"}],"key":"lCCFgIa6TZ"},{"type":"heading","depth":3,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"For the Physician:","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"vgNiwEd631"}],"identifier":"for-the-physician","label":"For the Physician:","html_id":"for-the-physician","implicit":true,"key":"PaqyiD36by"},{"type":"heading","depth":4,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"“Precision Diagnostic Suite”","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"GNuifBsd8m"}],"identifier":"precision-diagnostic-suite","label":"“Precision Diagnostic Suite”","html_id":"precision-diagnostic-suite","implicit":true,"key":"KEnpJmskJU"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":61,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"syGlass Implementation: Enables “Virtual Micro-Slicing.” The Physician can freeze a SciStream live-feed and use syGlass tools to measure the density of neural firing or track electrode degradation in 1:1 scale.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"IUQsUsLyUH"}],"key":"leIRzdDqxT"}],"key":"Olfq4ZtGCn"},{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Synergy: While inside the syGlass VR environment, the Physician can trigger SciX queries via voice command (e.g., “SciX: Show similar activation patterns in recent epilepsy studies”), with the results appearing as floating windows next to the live 3D brain model.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"XlRvJb6KYh"}],"key":"LOx9jOJJj5"}],"key":"Xw4fTUuJVu"}],"key":"bXgLswRUqD"},{"type":"heading","depth":4,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"“Sensory Re-Calibration”","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"r2jbh5FSRj"}],"identifier":"sensory-re-calibration","label":"“Sensory Re-Calibration”","html_id":"sensory-re-calibration","implicit":true,"key":"KmEX91HLyo"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":65,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tactile Mapping: If a user has lost sensation in a limb, the Physician can use syGlass in XR to manually stimulate specific “dead” zones. By “tapping” a virtual neuron in the XR environment, they send a signal to the NESD to trigger a phantom touch for the user.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"XkemseSOEF"}],"key":"P2BrCAPj10"}],"key":"YVX9Fyoc7o"},{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Pain Suppression: The Physician can identify “pain circuits” (hyper-active clusters) and use an XR interface to “dim” those regions, sending inhibitory signals to provide immediate relief.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"VYVbVqisoX"}],"key":"moanHef86K"}],"key":"dULBjkRYUc"},{"type":"listItem","spread":true,"position":{"start":{"line":67,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"SciX Integration: During manipulation, SciX provides real-time “Safety Envelopes.” If the Physician tries to stimulate a region too intensely, SciX flags a clinical study or safety protocol as a HUD overlay in the XR headset.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"PtGKeiHw0g"}],"key":"dBotDj2arV"}],"key":"kMAZfwnhwQ"}],"key":"manMX5Ro3O"},{"type":"heading","depth":2,"position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Technical Implementation via syGlass & SciStream","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"YGPg65nKqS"}],"identifier":"technical-implementation-via-syglass-scistream","label":"Technical Implementation via syGlass & SciStream","html_id":"technical-implementation-via-syglass-scistream","implicit":true,"key":"OQn29kHddx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Haptic Mirroring: Use the syGlass Python API to map XR controller coordinates to the 3D coordinates of the neural implant’s electrode array.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"fk7GgLCmDo"}],"key":"h50RBZTgzA"}],"key":"aj7KhAtoKN"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Latent Feedback (SciStream): To avoid “sensory lag” (which causes nausea or seizures), SciStream must maintain a sub-10ms round-trip latency between the XR “click” and the neural stimulation.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"tQ9ooKuABK"}],"key":"s7WRpVlel6"}],"key":"zXYMdFx8YV"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Visual-Neural Sync: The XR environment (syGlass) ensures that the visual representation of the brain matches the physical stimulation site with micrometer precision, preventing “misfires” in sensitive brain regions.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"O5yx9zZkNq"}],"key":"O8z0nxwDQa"}],"key":"FE0tK9w3g9"}],"key":"phl3WIlXZl"},{"type":"heading","depth":2,"position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"1. The Nanosat Bridge (The Physical Link)","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"ly9ymiom2A"}],"identifier":"id-1-the-nanosat-bridge-the-physical-link","label":"1. The Nanosat Bridge (The Physical Link)","html_id":"id-1-the-nanosat-bridge-the-physical-link","implicit":true,"key":"o7JtfmAQnC"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Modern Nanosats (3U to 12U CubeSats) act as Tactical Edge Nodes in orbit.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"BktpVrvTOq"}],"key":"VJTeXiIhiS"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":76,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Hardware: The Nanosat carries a Q-NET-compatible laser terminal or a high-frequency Ka-band radio.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"I8DbmjDHYl"}],"key":"Fe3bvHbzXa"}],"key":"W6rpwFsyxG"},{"type":"listItem","spread":true,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Link: The MEG-fiber interface (worn by the user) transmits data to a local ground terminal (running your K3s/Go/Envoy stack). This terminal “uplinks” the encrypted neural stream to the Nanosat.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"rREVwWTRBH"}],"key":"Q487ivOwFH"}],"key":"B33X6CYCa5"},{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Q-NET Extension: Some Nanosats now perform Space-to-Ground Quantum Key Distribution (QKD). The satellite beams entangled photons down to the ground terminal, providing the “Quantum Seed” for your TLS 1.3 tunnel even in areas without physical fiber.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"In8zLLvufr"}],"key":"QGskootfK6"}],"key":"BVdANzAQ8Q"}],"key":"sKpGh0cmWi"},{"type":"heading","depth":2,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"2. CSDAP Integration (The Data Layer)","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"k17dz3VFl2"}],"identifier":"id-2-csdap-integration-the-data-layer","label":"2. CSDAP Integration (The Data Layer)","html_id":"id-2-csdap-integration-the-data-layer","implicit":true,"key":"mDPZa9WRaD"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"CSDAP is the NASA/DoD program that buys commercial satellite data (from companies like Planet, Spire, or BlackSky) for government use.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"EUBZQI9rcb"}],"key":"fGTgTign3r"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":82,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Contextual Awareness: CSDAP provides high-resolution imagery and RF signals from the user’s specific location.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"FaFfnquVjL"}],"key":"HLlv64EiUe"}],"key":"NlgQ4kMzNm"},{"type":"listItem","spread":true,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Fusion: Your Go-based microservice in the cloud merges the “Neural Stream” (what the user is thinking/feeling) with “CSDAP Data” (what the satellites see around the user).","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"ceOUDprEms"}],"key":"MoTVLAaDmq"}],"key":"ciWOy0vXyq"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Example: If the user’s neural interface detects a high-stress “threat” response, the system automatically pulls the latest CSDAP SAR (Synthetic Aperture Radar) imagery of the surrounding 5km to identify potential hazards.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"HIFSKp5PjC"}],"key":"VpcbkVUgTN"}],"key":"oV7zufSpGv"}],"key":"ViLaJhVKmx"},{"type":"heading","depth":2,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"3. Implementing the “Space-Aware” Pod","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"GClJ0Yb0DE"}],"identifier":"id-3-implementing-the-space-aware-pod","label":"3. Implementing the “Space-Aware” Pod","html_id":"id-3-implementing-the-space-aware-pod","implicit":true,"key":"uekN7abtAc"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"To make this work, your K3s Pods must be “Space-Aware”:\nProtocol Optimization: Standard TCP/IP fails over satellite due to high latency. Your Envoy Wrapper is configured to use QUIC (UDP-based) or SCPS (Space Communications Protocol Specifications) to keep the neural stream fluid.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"DlLMPTkPbI"}],"key":"xzctmSqgXR"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intermittent Connectivity: The Go driver uses a “Store and Forward” buffer. If the Nanosat passes behind a mountain, the MEG-powered interface stores the neural data in a local Sidecar and bursts it to the satellite once the link is restored.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"xCRhI4RzY9"}],"key":"ap5oYcg4Zw"}],"key":"DW3JKvuBrg"}],"key":"ZxuiwHYr8m"},{"type":"heading","depth":2,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"4. Identity & Access (Entra ID in Space)","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"h99vQs5Oc8"}],"identifier":"id-4-identity-access-entra-id-in-space","label":"4. Identity & Access (Entra ID in Space)","html_id":"id-4-identity-access-entra-id-in-space","implicit":true,"key":"cHSBpuI7hn"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":92,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cross-Domain Identity: Entra ID manages the permissions for the satellite uplink. The Nanosat verifies the user’s Workload Identity before allowing the data to enter the “Space Segment” of the DoDIN.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"rIXnOqbhqH"}],"key":"Qkj1hrwU9b"}],"key":"RuX4QhrwTN"},{"type":"listItem","spread":true,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stream Access: A commander at a HQ can view the “CSDAP + Neural” fusion dashboard. Think Neuralink with first person visual and subtitles. They authenticate via Entra ID MFA, and the Envoy Proxy decrypts the satellite-delivered stream in real-time.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"mgoMFDZ9fj"}],"key":"bHDo2nVAsY"}],"key":"Qhdv6v0rHj"}],"key":"x0PUlcZebX"}],"key":"zkVSb3TX8t"}],"key":"s4gKtBlp4g"},"references":{"cite":{"order":["Chung2022SciStream"],"data":{"Chung2022SciStream":{"label":"Chung2022SciStream","enumerator":"1","doi":"10.1145/3502181.3531475","html":"Chung, J., Zacherek, W., Wisniewski, A., Liu, Z., Bicer, T., Kettimuthu, R., & Foster, I. (2022). SciStream. <i>Proceedings of the 31st International Symposium on High-Performance Parallel and Distributed Computing</i>, 185–198. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1145/3502181.3531475\">10.1145/3502181.3531475</a>","url":"https://doi.org/10.1145/3502181.3531475"}}}},"footer":{"navigation":{"prev":{"title":"Index","url":"/index-14","group":"Dashboard"},"next":{"title":"Biological Assets","url":"/bio-assets","group":"Dashboard"}}},"domain":"http://localhost:3000"}