":"jEYCBys26S"},{"type":"listItem","spread":true,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Link: The MEG-fiber interface (worn by the user) transmits data to a local ground terminal (running your K3s/Go/Envoy stack). This terminal “uplinks” the encrypted neural stream to the Nanosat.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"PRpb9m70S3"}],"key":"jTpvbIMer7"}],"key":"RDpfCWiLUv"},{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Q-NET Extension: Some Nanosats now perform Space-to-Ground Quantum Key Distribution (QKD). The satellite beams entangled photons down to the ground terminal, providing the “Quantum Seed” for your TLS 1.3 tunnel even in areas without physical fiber.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"HLiA2Vjb5g"}],"key":"PUY4mZKSxV"}],"key":"pLR1S5Nksa"}],"key":"vi1qyTvbW1"},{"type":"heading","depth":2,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"2. CSDAP Integration (The Data Layer)","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"CLHciMuAAg"}],"identifier":"id-2-csdap-integration-the-data-layer","label":"2. CSDAP Integration (The Data Layer)","html_id":"id-2-csdap-integration-the-data-layer","implicit":true,"key":"mPHWFsRGQC"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"CSDAP is the NASA/DoD program that buys commercial satellite data (from companies like Planet, Spire, or BlackSky) for government use.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"x7bqstXFeT"}],"key":"ZHHxwnJcoY"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":82,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Contextual Awareness: CSDAP provides high-resolution imagery and RF signals from the user’s specific location.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"aoNK6idL9Z"}],"key":"xWDt4D1YRk"}],"key":"fP8YhVfiUb"},{"type":"listItem","spread":true,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Fusion: Your Go-based microservice in the cloud merges the “Neural Stream” (what the user is thinking/feeling) with “CSDAP Data” (what the satellites see around the user).","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"AMdsOusaaK"}],"key":"UYZU6rUGQY"}],"key":"NKq8H1qcTo"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Example: If the user’s neural interface detects a high-stress “threat” response, the system automatically pulls the latest CSDAP SAR (Synthetic Aperture Radar) imagery of the surrounding 5km to identify potential hazards.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"pTKVrGcE52"}],"key":"mkBa1e3evL"}],"key":"v3rcVRgDer"}],"key":"GZvIAvTcef"},{"type":"heading","depth":2,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"3. Implementing the “Space-Aware” Pod","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"Z6NES73AOz"}],"identifier":"id-3-implementing-the-space-aware-pod","label":"3. Implementing the “Space-Aware” Pod","html_id":"id-3-implementing-the-space-aware-pod","implicit":true,"key":"iJArpGG9vi"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"To make this work, your K3s Pods must be “Space-Aware”:\nProtocol Optimization: Standard TCP/IP fails over satellite due to high latency. Your Envoy Wrapper is configured to use QUIC (UDP-based) or SCPS (Space Communications Protocol Specifications) to keep the neural stream fluid.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"T9ZDkE9Urb"}],"key":"uBAEOKpVOo"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intermittent Connectivity: The Go driver uses a “Store and Forward” buffer. If the Nanosat passes behind a mountain, the MEG-powered interface stores the neural data in a local Sidecar and bursts it to the satellite once the link is restored.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"hmkfqqSsBL"}],"key":"TDBYIVtQrX"}],"key":"GKTiXt8bzo"}],"key":"KVz07suKrG"},{"type":"heading","depth":2,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"4. Identity & Access (Entra ID in Space)","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"u6QVlTEnPP"}],"identifier":"id-4-identity-access-entra-id-in-space","label":"4. Identity & Access (Entra ID in Space)","html_id":"id-4-identity-access-entra-id-in-space","implicit":true,"key":"P93R3vIGM6"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":92,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cross-Domain Identity: Entra ID manages the permissions for the satellite uplink. The Nanosat verifies the user’s Workload Identity before allowing the data to enter the “Space Segment” of the DoDIN.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"Jyx45sOfG1"}],"key":"XGvR7sRIoe"}],"key":"wHnmihP69v"},{"type":"listItem","spread":true,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stream Access: A commander at a HQ can view the “CSDAP + Neural” fusion dashboard. Think Neuralink with first person visual and subtitles. They authenticate via Entra ID MFA, and the Envoy Proxy decrypts the satellite-delivered stream in real-time.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"iWcL5EmzR0"}],"key":"WZhYAT9p7P"}],"key":"XByCktf4kx"}],"key":"Rsdd3d21g7"}],"key":"TRvuYgggcl"}],"key":"qJ5V1U3quV"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Index","url":"/index-12","group":"Dashboard"},"next":{"title":"Biological Assets","url":"/bio-assets","group":"Dashboard"}}},"domain":"http://localhost:3000"}