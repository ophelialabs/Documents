 visualizes “Intent Bubbles”—zones of the motor cortex lighting up before a physical action is taken.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"waQRx9069D"}],"key":"tiTPZia4rX"}],"key":"fqQGlQMxP8"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Synergy: If SciStream detects a lag in the neural-to-digital link, syGlass can highlight the “bottleneck” area in red within the Commander’s field of view, allowing for an immediate tactical swap or mission abort.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"w6fLOHFTB6"}],"key":"O9R8jokgnm"}],"key":"UGaAMhTWWo"}],"key":"RMkXNfGUi7"},{"type":"heading","depth":4,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"“Augmented Intent”","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"NsnTGXZMy1"}],"identifier":"augmented-intent","label":"“Augmented Intent”","html_id":"augmented-intent","implicit":true,"key":"sW0WT6DARr"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":56,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sensory Injection: The Commander can “push” tactical data directly into the user’s sensory perception. For example, injecting a “thermal sense” or “spatial ping” into the user’s parietal lobe, allowing them to “feel” an enemy’s location without looking at a screen.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"AI8pHTvmf1"}],"key":"fwao25M8IN"}],"key":"KB3yE4hmVV"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Focus Steering: By manipulating the XR dashboard, the Commander can boost the user’s visual processing or auditory gain during high-stress moments, effectively “tuning” the user’s brain for the mission.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"BlNyNHdNbK"}],"key":"XdeRBUYAOq"}],"key":"OdG4YVWl5h"}],"key":"SIcxS8hda0"},{"type":"heading","depth":3,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"For the Physician:","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"vGrk9k1YC1"}],"identifier":"for-the-physician","label":"For the Physician:","html_id":"for-the-physician","implicit":true,"key":"nhevIsW1gl"},{"type":"heading","depth":4,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"“Precision Diagnostic Suite”","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"Moi1uJdANR"}],"identifier":"precision-diagnostic-suite","label":"“Precision Diagnostic Suite”","html_id":"precision-diagnostic-suite","implicit":true,"key":"p15JROmkSU"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":61,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"syGlass Implementation: Enables “Virtual Micro-Slicing.” The Physician can freeze a SciStream live-feed and use syGlass tools to measure the density of neural firing or track electrode degradation in 1:1 scale.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"YURcIIwQkB"}],"key":"C78XJyttXO"}],"key":"uE2QHDDQUT"},{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Synergy: While inside the syGlass VR environment, the Physician can trigger SciX queries via voice command (e.g., “SciX: Show similar activation patterns in recent epilepsy studies”), with the results appearing as floating windows next to the live 3D brain model.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"cXPVcNf5b6"}],"key":"jmRV9AL6fc"}],"key":"IKpYdZFVEY"}],"key":"XPq16MxAtv"},{"type":"heading","depth":4,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"“Sensory Re-Calibration”","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"diTIpAqprz"}],"identifier":"sensory-re-calibration","label":"“Sensory Re-Calibration”","html_id":"sensory-re-calibration","implicit":true,"key":"okjuIoW5N5"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":65,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tactile Mapping: If a user has lost sensation in a limb, the Physician can use syGlass in XR to manually stimulate specific “dead” zones. By “tapping” a virtual neuron in the XR environment, they send a signal to the NESD to trigger a phantom touch for the user.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"GOLJPKSOvb"}],"key":"jkZLF4dZaV"}],"key":"AprxOXDT2Q"},{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Pain Suppression: The Physician can identify “pain circuits” (hyper-active clusters) and use an XR interface to “dim” those regions, sending inhibitory signals to provide immediate relief.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"WSnwjuP