":"hlSiMjypii"},{"type":"listItem","spread":true,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Link: The MEG-fiber interface (worn by the user) transmits data to a local ground terminal (running your K3s/Go/Envoy stack). This terminal “uplinks” the encrypted neural stream to the Nanosat.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"q1vROay5Pl"}],"key":"xaNxog7OZY"}],"key":"QFKeuM8F4l"},{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Q-NET Extension: Some Nanosats now perform Space-to-Ground Quantum Key Distribution (QKD). The satellite beams entangled photons down to the ground terminal, providing the “Quantum Seed” for your TLS 1.3 tunnel even in areas without physical fiber.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"HBqqmgKaZe"}],"key":"Kn2JhZW7Xi"}],"key":"fds383r9C0"}],"key":"b8LI6ryb1a"},{"type":"heading","depth":2,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"2. CSDAP Integration (The Data Layer)","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"ue7H5ycBxI"}],"identifier":"id-2-csdap-integration-the-data-layer","label":"2. CSDAP Integration (The Data Layer)","html_id":"id-2-csdap-integration-the-data-layer","implicit":true,"key":"stelXpPJjs"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"CSDAP is the NASA/DoD program that buys commercial satellite data (from companies like Planet, Spire, or BlackSky) for government use.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"dXIgK9Xuig"}],"key":"ZJMyUbLKPP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":82,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Contextual Awareness: CSDAP provides high-resolution imagery and RF signals from the user’s specific location.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"aYd2qI5Sdi"}],"key":"L76QtURxKi"}],"key":"FueIjXHKIl"},{"type":"listItem","spread":true,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Fusion: Your Go-based microservice in the cloud merges the “Neural Stream” (what the user is thinking/feeling) with “CSDAP Data” (what the satellites see around the user).","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"FgPQt4vrBJ"}],"key":"st34PiwttH"}],"key":"hVvXRPH56Q"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Example: If the user’s neural interface detects a high-stress “threat” response, the system automatically pulls the latest CSDAP SAR (Synthetic Aperture Radar) imagery of the surrounding 5km to identify potential hazards.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"XCYXcwZFaZ"}],"key":"du1wxFO6Cr"}],"key":"T8i5N4XPhO"}],"key":"DRp9YqkQIa"},{"type":"heading","depth":2,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"3. Implementing the “Space-Aware” Pod","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"EHVylusxRb"}],"identifier":"id-3-implementing-the-space-aware-pod","label":"3. Implementing the “Space-Aware” Pod","html_id":"id-3-implementing-the-space-aware-pod","implicit":true,"key":"GohMduKuZX"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"To make this work, your K3s Pods must be “Space-Aware”:\nProtocol Optimization: Standard TCP/IP fails over satellite due to high latency. Your Envoy Wrapper is configured to use QUIC (UDP-based) or SCPS (Space Communications Protocol Specifications) to keep the neural stream fluid.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"lg8tkdXknK"}],"key":"eWNuTwuDzr"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intermittent Connectivity: The Go driver uses a “Store and Forward” buffer. If the Nanosat passes behind a mountain, the MEG-powered interface stores the neural data in a local Sidecar and bursts it to the satellite once the link is restored.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"Edmuks7Gm5"}],"key":"fpHGKLlRZx"}],"key":"gPqK3qtagx"}],"key":"YwvitwQzL0"},{"type":"heading","depth":2,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"4. Identity & Access (Entra ID in Space)","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"kDFLdQYbtk"}],"identifier":"id-4-identity-access-entra-id-in-space","label":"4. Identity & Access (Entra ID in Space)","html_id":"id-4-identity-access-entra-id-in-space","implicit":true,"key":"aU8uSQ3Ape"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":92,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cross-Domain Identity: Entra ID manages the permissions for the satellite uplink. The Nanosat verifies the user’s Workload Identity before allowing the data to enter the “Space Segment” of the DoDIN.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"NjpzGvbanK"}],"key":"oac7Zx68lp"}],"key":"Ru4sFf9YrR"},{"type":"listItem","spread":true,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stream Access: A commander at a HQ can view the “CSDAP + Neural” fusion dashboard. Think Neuralink with first person visual and subtitles. They authenticate via Entra ID MFA, and the Envoy Proxy decrypts the satellite-delivered stream in real-time.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"jdGqt2xwxo"}],"key":"aNWp92WDKp"}],"key":"wHsDAg8jVF"}],"key":"SfNzVxyEyB"}],"key":"AwrXMG5J3B"}],"key":"dzwCOD7lI5"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Index","url":"/index-12","group":"Dashboard"},"next":{"title":"Biological Assets","url":"/bio-assets","group":"Dashboard"}}},"domain":"http://localhost:3000"}