qqF5YKebH"}],"key":"ACv3VQ5Wfa"}],"key":"gYCUQM3gCr"},{"type":"listItem","spread":true,"position":{"start":{"line":67,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"SciX Integration: During manipulation, SciX provides real-time “Safety Envelopes.” If the Physician tries to stimulate a region too intensely, SciX flags a clinical study or safety protocol as a HUD overlay in the XR headset.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"pRqZSzxyYY"}],"key":"NDOMJSmEGj"}],"key":"RprGcvKfZY"}],"key":"eyZOCcNnxV"},{"type":"heading","depth":2,"position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Technical Implementation via syGlass & SciStream","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"y6Wgh6qPc2"}],"identifier":"technical-implementation-via-syglass-scistream","label":"Technical Implementation via syGlass & SciStream","html_id":"technical-implementation-via-syglass-scistream","implicit":true,"key":"XE7qH0r7x5"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Haptic Mirroring: Use the syGlass Python API to map XR controller coordinates to the 3D coordinates of the neural implant’s electrode array.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"a4pW3xAlta"}],"key":"pG0PnigfU1"}],"key":"Lf9isywF7r"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Latent Feedback (SciStream): To avoid “sensory lag” (which causes nausea or seizures), SciStream must maintain a sub-10ms round-trip latency between the XR “click” and the neural stimulation.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"c9mZUMiThF"}],"key":"L9cntZYhk2"}],"key":"oUPFmENefG"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Visual-Neural Sync: The XR environment (syGlass) ensures that the visual representation of the brain matches the physical stimulation site with micrometer precision, preventing “misfires” in sensitive brain regions.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"CfUBY6y1Xn"}],"key":"fmKUytfMjA"}],"key":"gzHGRu9Mud"}],"key":"KC14w43DI1"},{"type":"heading","depth":2,"position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"1. The Nanosat Bridge (The Physical Link)","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"mnKNnwbjqV"}],"identifier":"id-1-the-nanosat-bridge-the-physical-link","label":"1. The Nanosat Bridge (The Physical Link)","html_id":"id-1-the-nanosat-bridge-the-physical-link","implicit":true,"key":"IWAQqpUNPC"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Modern Nanosats (3U to 12U CubeSats) act as Tactical Edge Nodes in orbit.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"YscyhHX0Nq"}],"key":"NSk7DSxmNu"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":76,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Hardware: The Nanosat carries a Q-NET-compatible laser terminal or a high-frequency Ka-band radio.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"YZcf97gocM"}],"key":"taGHZfEEbd"}],"key":"bEu0yjOvYg"},{"type":"listItem","spread":true,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Link: The MEG-fiber interface (worn by the user) transmits data to a local ground terminal (running your K3s/Go/Envoy stack). This terminal “uplinks” the encrypted neural stream to the Nanosat.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"WiochdvIhi"}],"key":"bNJGUuR3It"}],"key":"D57Wpmq8fU"},{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Q-NET Extension: Some Nanosats now perform Space-to-Ground Quantum Key Distribution (QKD). The satellite beams entangled photons down to the ground terminal, providing the “Quantum Seed” for your TLS 1.3 tunnel even in areas without physical fiber.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"vmApqfN8M1"}],"key":"NcsTjFSBkB"}],"key":"t2DsI0IRcA"}],"key":"fhrPN92LKj"},{"type":"heading","depth":2,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"2. CSDAP Integration (The Data Layer)","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"UyMGkp097W"}],"identifier":"id-2-csdap-integration-the-data-layer","label":"2. CSDAP Integration (The Data Layer)","html_id":"id-2-csdap-integration-the-data-layer","implicit":true,"key":"Gawff7MfpS"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"CSDAP is the NASA/DoD program that buys commercial satellite data (from companies like Planet, Spire, or BlackSky) for government use.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"T6apwgsxtd"}],"key":"NSIAePwLfZ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":82,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Contextual Awareness: CSDAP provides high-resolution imagery and RF signals from the user’s specific location.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"zTfkMrPmVU"}],"key":"olWAr6oMsf"}],"key":"KpQDDzkD5Y"},{"type":"listItem","spread":true,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The Fusion: Your Go-based microservice in the cloud merges the “Neural Stream” (what the user is thinking/feeling) with “CSDAP Data” (what the satellites see around the user).","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"dSWIRU6cTn"}],"key":"Ph5f9F7JOz"}],"key":"XhmnM2tUQF"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Example: If the user’s neural interface detects a high-stress “threat” response, the system automatically pulls the latest CSDAP SAR (Synthetic Aperture Radar) imagery of the surrounding 5km to identify potential hazards.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"UDltECBVEw"}],"key":"U6wMdlcIut"}],"key":"HnupmFiC9P"}],"key":"kTUOCUKUbC"},{"type":"heading","depth":2,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"3. Implementing the “Space-Aware” Pod","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"t2gUNm62oz"}],"identifier":"id-3-implementing-the-space-aware-pod","label":"3. Implementing the “Space-Aware” Pod","html_id":"id-3-implementing-the-space-aware-pod","implicit":true,"key":"AQ8frfnBDT"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"To make this work, your K3s Pods must be “Space-Aware”:\nProtocol Optimization: Standard TCP/IP fails over satellite due to high latency. Your Envoy Wrapper is configured to use QUIC (UDP-based) or SCPS (Space Communications Protocol Specifications) to keep the neural stream fluid.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"XoW4bw7rL4"}],"key":"EVDtlVCYUQ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":89,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intermittent Connectivity: The Go driver uses a “Store and Forward” buffer. If the Nanosat passes behind a mountain, the MEG-powered interface stores the neural data in a local Sidecar and bursts it to the satellite once the link is restored.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"tiy54hwT2T"}],"key":"ioM8CoHFb4"}],"key":"OSfldVyk67"}],"key":"HDhYiaGzYz"},{"type":"heading","depth":2,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"4. Identity & Access (Entra ID in Space)","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"ImivoB1ldv"}],"identifier":"id-4-identity-access-entra-id-in-space","label":"4. Identity & Access (Entra ID in Space)","html_id":"id-4-identity-access-entra-id-in-space","implicit":true,"key":"qtyosXmi60"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":92,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cross-Domain Identity: Entra ID manages the permissions for the satellite uplink. The Nanosat verifies the user’s Workload Identity before allowing the data to enter the “Space Segment” of the DoDIN.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"ZQr5cI82yZ"}],"key":"SdyrYoWDGa"}],"key":"CHEnfEpi4Y"},{"type":"listItem","spread":true,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stream Access: A commander at a HQ can view the “CSDAP + Neural” fusion dashboard. Think Neuralink with first person visual and subtitles. They authenticate via Entra ID MFA, and the Envoy Proxy decrypts the satellite-delivered stream in real-time.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"CmM56m234B"}],"key":"CNHFoecsin"}],"key":"XS7M5IHfSC"}],"key":"xlHn48Kq13"}],"key":"ECqYnzhbiW"}],"key":"krBmUDtwxX"},"references":{"cite":{"order":["Chung_2022"],"data":{"Chung_2022":{"label":"Chung_2022","enumerator":"1","doi":"10.1145/3502181.3531475","html":"Chung, J., Zacherek, W., Wisniewski, A., Liu, Z., Bicer, T., Kettimuthu, R., & Foster, I. (2022). SciStream: Architecture and Toolkit for Data Streaming between Federated Science Instruments. <i>Proceedings of the 31st International Symposium on High-Performance Parallel and Distributed Computing</i>, 185–198. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1145/3502181.3531475\">10.1145/3502181.3531475</a>","url":"https://doi.org/10.1145/3502181.3531475"}}}},"footer":{"navigation":{"prev":{"title":"Index","url":"/index-12","group":"Dashboard"},"next":{"title":"Biological Assets","url":"/bio-assets","group":"Dashboard"}}},"domain":"http://localhost:3000"}