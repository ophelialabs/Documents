{"version":3,"kind":"Article","sha256":"b2493d5f3b7c93d5aef9e860447afba5acbe62038fae01bb660d1a94b1ebeb9a","slug":"phage","location":"/02_Learn_Iseek/03_Physical_Computational_and_Applied_Sciences/Engineering/Medical/BioTechnology/phage.md","dependencies":[],"frontmatter":{"title":"[Biotechnology Program (BIT)]","content_includes_title":true,"numbering":{"title":{"offset":5}},"exports":[{"format":"md","filename":"phage.md","url":"/Documents/build/phage-e87b9e0d57290f006c9ffeb97d0324f5.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"[Biotechnology Program (BIT)]","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qgC3Ex6Ng6"}],"identifier":"id-biotechnology-program-bit","label":"[Biotechnology Program (BIT)]","html_id":"id-biotechnology-program-bit","implicit":true,"key":"ZYKQ4usTTV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"heading","depth":1,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Research","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"D2Jnydb67X"}],"identifier":"research","label":"Research","html_id":"research","implicit":true,"key":"YQAM8397U1"}],"key":"esSB1PlJAZ"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Edu","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"oLFaXgStHy"}],"key":"Mc7WGw9Dmp"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://biotech.ncsu.edu/","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"NC State","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"KeKt90PzJp"}],"urlSource":"https://biotech.ncsu.edu/","key":"wUA6kD4jk5"}],"key":"UkNqFd0TTN"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Course List","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"HZBnbQUG0X"}],"key":"dpe9sQR8Sx"}],"key":"B9RwFrEI3D"}],"key":"j9U9aZHaV2"}],"key":"ETCRPLAHns"}],"key":"lYMJQQJGws"}],"key":"l2W9oMb5ti"}],"key":"pMd6FNWi9k"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"link","url":"https://vimeo.com/270203066","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[],"urlSource":"https://vimeo.com/270203066","key":"NFfClG6dAE"},{"type":"text","value":"\n","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"N5eHZea0xR"},{"type":"emphasis","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Electron microscopy (EM) beam damage on bacteriophages occurs rapidly","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"YuNt37VlzF"}],"key":"c1Aa0xf6LS"},{"type":"text","value":", often within seconds to minutes, due to high-energy electrons breaking molecular bonds in non-conductive, hydrated biological samples.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"EyLbduB92Y"}],"key":"x7p6nHqqFL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":11,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Severe damage (15-40% mass loss) can occur within 30 seconds of exposure, though with negative staining, some structures may remain identifiable for up to 4 minutes.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"kQjKTS7Jtp"}],"key":"I8N4RiOeZG"}],"key":"ihR2ASbTqU"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Key Considerations for Beam Damage and Time Limits:","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"I3zfp5kb3g"}],"key":"ZMAOsZUpJf"}],"key":"cityDCNIxQ"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Irradiation Damage: The electron beam rapidly breaks molecular bonds, altering the structure of the phage (e.g., tail contraction, DNA release).","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"b07nhe6NuD"}],"key":"TVS7HQUUs3"}],"key":"dLATFAthpN"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Exposure Time: While significant damage happens in 30 seconds, structural integrity for observation can be maintained for short periods; one study found, with negative staining, that the shape of specimens did not change significantly within 1-4 seconds of exposure.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"hOvjZm7Esl"}],"key":"LisvlXV0pC"}],"key":"uVfm7IByqN"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sample Preservation: Using negative stains helps, but to avoid damage entirely, cryo-electron microscopy (cryo-TEM) is required to freeze the sample, preventing the high vacuum from immediately destroying the sample.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"mwaSQA0xAL"}],"key":"fmSydBCbhw"}],"key":"mvdkLrYIvD"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Optimal Imaging Time: For identification, researchers typically aim to capture images as quickly as possible to minimize structural alterations, often within the first minute of beam exposure.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"LL7Id5VdZa"}],"key":"TLI5SpOLVW"}],"key":"ozTm43GAgG"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"To minimize damage, it is critical to use lower beam intensities and rapid, low-dose imaging techniques.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"ESwRckH3TG"}],"key":"v4ozj62hR8"}],"key":"rWdP3mxVit"}],"key":"gWRZNjoydm"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"link","url":"https://innovativegenomics.org/crisprpedia/crispr-in-nature/","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Crispr","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"IGXDZlmFQr"}],"urlSource":"https://innovativegenomics.org/crisprpedia/crispr-in-nature/","key":"wbaKmZOQAZ"},{"type":"text","value":"\nRestriction-modification (R-M) and CRISPR-Cas are bacterial immune systems used by prokaryotes to defend against foreign DNA, such as phages and plasmids, by targeting and cleaving specific DNA sequences. While R-M acts as innate immunity using restriction enzymes and methylation, CRISPR-Cas provides adaptive immunity by storing snippets of prior invaders to guide future immune responses.\n","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"sVs0fshYTi"},{"type":"link","url":"https://innovativegenomics.org/wp-content/uploads/2024/10/Defense-systems-1536x989.png","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"img","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"k6ro6pGBfz"}],"urlSource":"https://innovativegenomics.org/wp-content/uploads/2024/10/Defense-systems-1536x989.png","key":"auUP1qlDac"}],"key":"uv45jyttui"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Restriction-Modification (R-M) Systems","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"N870PWsyWG"}],"identifier":"restriction-modification-r-m-systems","label":"Restriction-Modification (R-M) Systems","html_id":"restriction-modification-r-m-systems","implicit":true,"key":"DLJz6BTS3N"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":24,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Mechanism: Consists of a restriction enzyme (REase) that cuts foreign DNA at specific recognition sites and a methyltransferase (MTase) that modifies (methylates) the host’s own DNA to prevent self-cleavage.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"HpOwy8obwB"}],"key":"v5FW7GJhQ3"}],"key":"qSaaWSrzel"},{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Function: Acts as a rapid, innate, and generally sequence-specific barrier to foreign DNA.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"BqHloI0lv0"}],"key":"pCvW8dc7zH"}],"key":"MmHmQimJ7H"},{"type":"listItem","spread":true,"position":{"start":{"line":26,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Limitation: It cannot adapt to new pathogens and can be bypassed by phages through DNA modification (e.g., glycosylation).","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"mtBe17C7Nc"}],"key":"MUtC59E8hV"}],"key":"M6AXRrbMAj"}],"key":"TrwF8gjj3V"},{"type":"heading","depth":2,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"CRISPR-Cas Systems","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"zwWkdZHtkk"}],"identifier":"crispr-cas-systems","label":"CRISPR-Cas Systems","html_id":"crispr-cas-systems","implicit":true,"key":"U2WU9pbwoB"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Mechanism: Uses small, CRISPR-associated RNAs (crRNAs) to guide Cas proteins (like Cas9) to specific foreign DNA sequences.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"xMCAcUDuD4"}],"key":"U12pY3Cn9y"}],"key":"BHpAMP4PUC"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Function: Adaptive immunity. During infection, new spacers (small snippets of viral DNA) are acquired and inserted into the CRISPR locus, allowing the system to recognize and destroy that specific pathogen upon reinfection.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"zcpbMcSiJ9"}],"key":"Qx1xFKCCM9"}],"key":"FNqKeHetxm"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Types: Major types include Type I (Cas3), Type II (Cas9), and Type III (Cas10).\nInteraction and Cooperation","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"BPTJpXVl1K"}],"key":"Qt5aLEiRs6"}],"key":"ekDdbdmBO4"},{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Synergy: R-M and CRISPR-Cas systems often coexist, providing complementary protection.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"KrdJOOlc21"}],"key":"P8wzOmGGly"}],"key":"fPCA9nTbtt"},{"type":"listItem","spread":true,"position":{"start":{"line":34,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Interplay: R-M systems can provide temporary protection, allowing time for the CRISPR-Cas system to acquire new spacers, thus facilitating a more robust adaptive immune response.\nEvolutionary Pressure: Bacteria with both systems show a lower rate of escape by bacteriophages.\n","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"cMmRN9VozI"},{"type":"emphasis","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Key Differences","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"GoUGrGOUkk"}],"key":"kRnaaa7rJX"}],"key":"XeiBoaS6bN"}],"key":"l8NhiiE2AJ"},{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Specificity: R-M is sequence-specific but not adaptable, whereas CRISPR-Cas is highly adaptable to new sequences.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"M9JVXwfkM0"}],"key":"gF8sHcB9iv"}],"key":"IaRIzCfQNO"},{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Memory: CRISPR-Cas provides memory of past infections, while R-M does not.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"XPYeg5MalF"}],"key":"Wv3f2lZzo4"}],"key":"on3kzY8tIV"}],"key":"Vh5TvmgYyd"},{"type":"heading","depth":2,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Functional Comparison","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"uAmfCuClWX"}],"identifier":"functional-comparison","label":"Functional Comparison","html_id":"functional-comparison","implicit":true,"key":"ucgCwpjLar"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Feature \tRestriction-Modification (R-M)\tCRISPR-Cas\nImmunity Type\tInnate; acts as a first line of defense against any foreign DNA with specific target sites.\tAdaptive; “remembers” past infections by storing foreign DNA fragments as spacers.\nMechanism\tEmploys a restriction endonuclease to cut DNA and a methyltransferase to protect “self” DNA.\tUses crRNAs to guide Cas proteins to complementary foreign DNA for cleavage.\nSpecificity\tLimited to specific, short recognition sequences.\tHighly specific; can be programmed to target almost any sequence matching its spacers.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ZLXvng754o"}],"key":"N9LL0nOifr"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Comparison of R-M and CRISPR-Cas Systems","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"QJDBosl8tk"}],"identifier":"comparison-of-r-m-and-crispr-cas-systems","label":"Comparison of R-M and CRISPR-Cas Systems","html_id":"comparison-of-r-m-and-crispr-cas-systems","implicit":true,"key":"lB41yvMEln"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Feature \tRestriction-Modification (R-M)\tCRISPR-Cas Systems\nImmunity Type\tInnate: Recognizes broad “non-self” patterns (lack of methylation).\tAdaptive: Uses a genetic memory (spacers) to target specific, previously encountered invaders.\nPrimary Mechanism\tMethyltransferase protects host DNA; Restriction Endonuclease (REase) cleaves unmethylated foreign DNA.\tGuide RNA (crRNA) directs Cas nucleases to specific complementary DNA or RNA sequences for cleavage.\nComponents\tTypically two enzymes: a restriction enzyme and a methyltransferase.\tCRISPR array (memory) and Cas genes (effector proteins).\nSpecificity\tLimited to short (often 4-8 bp) palindromic recognition sites.\tHigh specificity; can be reprogrammed to target almost any sequence by changing the spacer.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"rtWQT60Lo1"}],"key":"SUvQlUhr2S"},{"type":"heading","depth":2,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Synergistic Interaction","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"xkvOfz7TW2"}],"identifier":"synergistic-interaction","label":"Synergistic Interaction","html_id":"synergistic-interaction","implicit":true,"key":"kCR1TCtcL4"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Recent research highlights that these systems are not just independent hurdles but actually cooperate to enhance bacterial survival:","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"axo1TFLyeV"}],"key":"lwEaGjU6zF"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":56,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Substrate Generation: R-M systems provide short-lived initial defense. The double-strand breaks they create serve as substrates for new spacer acquisition by the CRISPR-Cas system.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"lwAQOSk5VR"}],"key":"ZT1z6DegqU"}],"key":"XgfAHU2pgz"},{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Long-term Protection: While phages can escape R-M through genome methylation, CRISPR-Cas can use these newly acquired spacers to extinguish “R-M-escapees,” providing robust, long-term immunity.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"z2tgWNLzpN"}],"key":"xFzfeDDeUT"}],"key":"pz1NJMaM9R"},{"type":"listItem","spread":true,"position":{"start":{"line":58,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Evolutionary Pressure: Coexistence reduces the frequency of “escape” mutants that must overcome both defenses simultaneously.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"YgpojMUFQ9"}],"key":"r7xva6CrFz"}],"key":"JRfJSFyFYy"}],"key":"zTRJVL9D9t"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"link","url":"https://share.google/G1BjusX9XPYdn1u5D","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[],"urlSource":"https://share.google/G1BjusX9XPYdn1u5D","key":"MBrtPcy6io"},{"type":"text","value":"\n","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"Sbg7Uknibf"},{"type":"link","url":"https://share.google/Po7mEjkQS5W5SiBL2","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[],"urlSource":"https://share.google/Po7mEjkQS5W5SiBL2","key":"NR8qAZjbAE"}],"key":"sB7FegsfSp"},{"type":"heading","depth":2,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Common Design Principles","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"BHysn29eIK"}],"identifier":"common-design-principles","label":"Common Design Principles","html_id":"common-design-principles","implicit":true,"key":"qc7KxtPicP"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Despite their mechanical differences, both systems exhibit similar expression dynamics optimized for host safety:","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"uZDyOXfVmV"}],"key":"LNcxwpcEfw"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":66,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Time Delay: Both prioritize protecting the host genome (via methylation in R-M or crRNA processing in CRISPR) before activating lethal cleavage.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"eldrcBWuzi"}],"key":"YtRa7XGlJM"}],"key":"KVFtq3tYwV"},{"type":"listItem","spread":true,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Switch-like Activation: They utilize cooperative transcription regulation to transition rapidly from an “OFF” to an “ON” state once an infection is detected.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"seejqK9lH5"}],"key":"un6yRutnUB"}],"key":"jCM1GdjkNb"},{"type":"listItem","spread":true,"position":{"start":{"line":68,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Steady-state Stability: Mathematical models show that both systems maintain stable levels of toxic components (restriction enzymes or Cas proteins) to avoid accidental self-damage.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"h6NWvcnXsL"}],"key":"vR6b2G3Ieh"}],"key":"CfF1AJZVka"}],"key":"hUaowJxW99"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"For more in-depth exploration, you can browse the Innovative Genomics Institute’s CRISPRpedia or view detailed research on synergistic defense at Nature.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"czoVXI6oHA"}],"key":"ysCwnTNkvI"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Look into the counter-defense mechanisms phages use to bypass them.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"HYLwQIwIq0"}],"key":"q1weAc4C19"},{"type":"thematicBreak","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"NKE28HFGIa"},{"type":"heading","depth":2,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Synthetic Bacteriophages and Engineering Advances","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"BHZ5hFJUEX"}],"identifier":"synthetic-bacteriophages-and-engineering-advances","label":"Synthetic Bacteriophages and Engineering Advances","html_id":"synthetic-bacteriophages-and-engineering-advances","implicit":true,"key":"AfzYd7vj3b"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Recent advances in bacteriophage research have illuminated the potential for synthetic bacteriophages to combat resistant bacterial infections. The engineering of these phages involves sophisticated methodologies that enhance their specificity and efficacy against targeted bacterial strains.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"juzUHRk26T"}],"key":"gmw3UUKJWL"},{"type":"heading","depth":2,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Synthetic Bacteriophages: A New Frontier","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"pewu0Poukr"}],"identifier":"synthetic-bacteriophages-a-new-frontier","label":"Synthetic Bacteriophages: A New Frontier","html_id":"synthetic-bacteriophages-a-new-frontier","implicit":true,"key":"beKDwkE7Po"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Synthetic bacteriophages are artificially constructed phages designed to exhibit enhanced capabilities. The development and engineering of these phages can be categorized into several key technological advancements:","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"xULdl3CN3i"}],"key":"ttrBiJmnBa"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":84,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"strong","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Genomic Engineering","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"qIMxfBZcAD"}],"key":"fSec1UUxXF"},{"type":"text","value":": Advances in bacteriophage genomics allow for the identification and modification of viral genomes to enhance targeting efficacy. This has led to the discovery of numerous phage-host interactions that can be optimized for therapeutic applications.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"gY68yIdd3y"}],"key":"Te4xoQwkPo"}],"key":"x965Fmog4c"},{"type":"listItem","spread":true,"position":{"start":{"line":86,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"strong","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Rational Design","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"AxWGyqiGFJ"}],"key":"kpIJx7NN97"},{"type":"text","value":": Utilizing AI and computational modeling, researchers can predict phage-host compatibility, identify functional phage genes, and rationally design phage genomes. Such designs can facilitate the construction of phages with specific traits tailored for therapeutic needs.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"Dg9PvC4rZN"}],"key":"ncfDJ1qe9l"}],"key":"YMEE9LryMN"},{"type":"listItem","spread":true,"position":{"start":{"line":88,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"strong","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"Modular Approaches","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"HvGGOZaMMd"}],"key":"CpoQfYC5IW"},{"type":"text","value":": The incorporation of modular systems facilitates faster assembly and customization of phage particles. Researchers can create phages that carry therapeutic genes, such as lytic enzymes, enabling a multifaceted attack against bacterial pathogens.","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"jHMXtdzSzr"}],"key":"WStbNJHbqG"}],"key":"poieVS3tEt"}],"key":"YGbr7NvsQw"},{"type":"heading","depth":2,"position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Engineering Advances in Phage Development","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"fA5MdYIhvy"}],"identifier":"engineering-advances-in-phage-development","label":"Engineering Advances in Phage Development","html_id":"engineering-advances-in-phage-development","implicit":true,"key":"rPZnlOLcyi"},{"type":"paragraph","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"The engineering of bacteriophages not only addresses the need for effective antibacterial therapies but also showcases the adaptability and versatility of phage systems. Recent efforts in engineering synthetic phages include:","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"D18CI81BHe"}],"key":"R55iTMj7YU"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":94,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":94,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"strong","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"Reprogrammed Phage Genomes","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"vUXVGSnOly"}],"key":"KhTDQjYcdE"},{"type":"text","value":": A fully synthetic method for constructing and reprogramming bacteriophages has been developed. This innovation offers a fast and safer route to design phages specifically targeting resistant bacterial strains[^1].","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"VqIsZErIyc"}],"key":"s34CdaUdMz"}],"key":"RfcvM7IOoE"},{"type":"listItem","spread":true,"position":{"start":{"line":96,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"strong","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"text","value":"Functionalization with Antibacterial Proteins","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"PcXspTF171"}],"key":"Tatk2Faajv"},{"type":"text","value":": Incorporating phage-derived proteins, such as lysins, has further strengthened the therapeutic potential of synthetic phages. These proteins can lyse bacterial cells upon infection, leading to more effective clearance of pathogens.","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"ek5OEari9T"}],"key":"vhJxVMDa8O"}],"key":"Iqt6BJf5QQ"},{"type":"listItem","spread":true,"position":{"start":{"line":98,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"strong","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"Adaptation to Microbial Environments","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"mJKWGRWMpR"}],"key":"v1gBnQjJae"},{"type":"text","value":": Investigating the ecological impacts of bacteriophages has led to insights on how phages can adapt to different microbial communities, enhancing their effectiveness across diverse conditions.","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"W2RtVtZXQE"}],"key":"SmmWtaVP1Q"}],"key":"vZPPSI5Xst"}],"key":"eOotSjbSco"},{"type":"heading","depth":2,"position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Conclusion","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"iRrdSEk1ud"}],"identifier":"conclusion","label":"Conclusion","html_id":"conclusion","implicit":true,"key":"leuDSsB4jJ"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Synthetic bacteriophages represent a promising platform in the fight against antibiotic-resistant bacteria. Continued research in engineering techniques, coupled with genomic advancements, will likely lead to innovative therapeutic applications, providing new avenues for combating infectious diseases. As the field progresses, it will be crucial to consider the ecological and ethical implications of deploying synthetic phages in clinical and environmental settings.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"gnNHB1Vy3F"}],"key":"NZ30Axrgt5"},{"type":"heading","depth":1,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Designing an RM-silent plasmid involves neutralizing the host’s “innate” defense by making your genetic tool invisible to its sensors.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"IVcAQEL9Bj"}],"identifier":"designing-an-rm-silent-plasmid-involves-neutralizing-the-hosts-innate-defense-by-making-your-genetic-tool-invisible-to-its-sensors","label":"Designing an RM-silent plasmid involves neutralizing the host’s “innate” defense by making your genetic tool invisible to its sensors.","html_id":"designing-an-rm-silent-plasmid-involves-neutralizing-the-hosts-innate-defense-by-making-your-genetic-tool-invisible-to-its-sensors","implicit":true,"key":"xq6k9akiy0"},{"type":"heading","depth":2,"position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Step 1: Define the Host Methylome","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"liPSrnqN3t"}],"identifier":"step-1-define-the-host-methylome","label":"Step 1: Define the Host Methylome","html_id":"step-1-define-the-host-methylome","implicit":true,"key":"GifRP1f6c6"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"Before you can hide, you must know what the host is looking for.\nSequence the Strain: Use PacBio or Oxford Nanopore sequencing to determine the genome and, crucially, the methylome of your target S. aureus strain.","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"vNkN1WVOh2"}],"key":"VfpMpXDmAP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify Motifs: Use tools like the REBASE database or the “RM search” program to pinpoint specific Type I and Type II recognition motifs (e.g., GATC or CCGG).","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"DV54RcmBt0"}],"key":"klAgY0uLKN"}],"key":"xMVsdKygHv"}],"key":"B6KYXvK9Go"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":110,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify Target RM Systems: Use the REBASE database to look up your specific bacterial strain. Note the recognition sequences for Type I (multi-subunit), Type II (standard restriction), and Type IV (methylation-dependent) systems.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"IVTmsFXYMa"}],"key":"w3FUO70O63"}],"key":"Jy2lSd91Mt"},{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sequence In Silico Scan: Perform a “Restriction Map” of your intended plasmid vector. Use tools like Benchling or SnapGene to highlight every instance where the host’s RM systems would cut your DNA.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"kmT14iazZg"}],"key":"jy7juOIWvq"}],"key":"rw9kD7iinC"}],"key":"MADi5U1dvJ"},{"type":"heading","depth":2,"position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Phase 2: Eliminating Recognition Sites","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"LEeHHd7M8O"}],"identifier":"phase-2-eliminating-recognition-sites","label":"Phase 2: Eliminating Recognition Sites","html_id":"phase-2-eliminating-recognition-sites","implicit":true,"key":"iYkrZAdyKD"},{"type":"list","ordered":true,"start":3,"spread":false,"position":{"start":{"line":114,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Synonymous Mutation Strategy: For sites located within essential plasmid components (like the antibiotic resistance gene or the rep gene), perform synonymous codon swapping. Change the DNA sequence to remove the RM site while maintaining the exact same amino acid sequence.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"wSEkn0TSkP"}],"key":"dlyZ1hOZXS"}],"key":"yi6XUCYrGg"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Target Deletion/Replacement: For sites in non-coding “backbone” regions (linkers or promoters), use Site-Directed Mutagenesis (SDM) or order a custom synthetic gene fragment that replaces the entire region with a sequence lacking those motifs.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"E2AbaUNWZ5"}],"key":"bgWCjlrsEu"}],"key":"YzMGNzpKZQ"},{"type":"listItem","spread":true,"position":{"start":{"line":116,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Remove Type IV “Bait”: If your host has a Type IV system (which targets modified DNA), ensure your plasmid is grown in an \\(McmrA^{-}B^{-}\\) E. coli strain (like DH10B or INV110) to prevent unwanted cytosine methylation that would trigger host suicide.","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"anuWQOtgtf"}],"key":"aO3xryYDI4"}],"key":"vWlqeZsZd7"}],"key":"LaAw2DVpE5"},{"type":"heading","depth":2,"position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"Phase 3: “Passing the Guard” (The Mimicry Step)","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"O2ergkXmdC"}],"identifier":"phase-3-passing-the-guard-the-mimicry-step","label":"Phase 3: “Passing the Guard” (The Mimicry Step)","html_id":"phase-3-passing-the-guard-the-mimicry-step","implicit":true,"key":"Kzjx6lZDg6"},{"type":"list","ordered":true,"start":6,"spread":false,"position":{"start":{"line":119,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":119,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"In Vivo Methylation (The “Shadow” Strain):\nBefore transforming your target pathogen, pass the RM-silent plasmid through an E. coli “mimic” strain. This is an E. coli engineered to express the host-specific methyltransferase genes you identified in Phase 1.Result: The plasmid emerges with the exact “self” methylation pattern the host expects.","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"UqfXui0pEo"}],"key":"OZ5q2uRduU"}],"key":"U459n0QpP4"},{"type":"listItem","spread":true,"position":{"start":{"line":121,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Final Transformation: Perform the transformation into your target strain (e.g., via electroporation). Because the plasmid lacks Type I sites and mimics Type II methylation, it should bypass the RM “meat grinder” and allow the CRISPR-Cas9 machinery to begin editing.","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"Om6Ka5S9BU"}],"key":"VXYHJCcqWT"}],"key":"nJeKu8zx22"}],"key":"vqTHlaslkF"},{"type":"heading","depth":2,"position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"Phase 4: Validation","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"fub4tRsXTj"}],"identifier":"phase-4-validation","label":"Phase 4: Validation","html_id":"phase-4-validation","implicit":true,"key":"wab91smczS"},{"type":"list","ordered":true,"start":8,"spread":false,"position":{"start":{"line":124,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":124,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Efficiency Check: Compare the Transformation Efficiency (CFU/µg) of your RM-silent plasmid against a non-modified control. You should see a log-scale increase in successful colonies.","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"zKGEAVbGxr"}],"key":"TgGr2jE9F9"}],"key":"rxNjUK6YSr"}],"key":"XfU8mQCswq"},{"type":"paragraph","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"Find the specific recognition motifs for a particular S. aureus clonal complex (e.g., USA300 or HG003).","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"ESWtJolLYy"}],"key":"JVrLZcBpFI"},{"type":"paragraph","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"To engineer USA300 or HG003 effectively, you must account for the Sau1 Type I RM system, which is the primary barrier to horizontal gene transfer in S. aureus. Each clonal complex (CC) possesses unique recognition motifs determined by specific HsdS subunits.","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"qTmnlq6eFm"}],"key":"YpyYt452lN"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":129,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":129,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"USA300 (CC8 / ST8) Recognition Motifs\nUSA300 belongs to Clonal Complex 8 (CC8). The Sau1 system in this lineage recognizes bipartite sequences with a specific central gap:","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"fqty2o4sNJ"}],"key":"QZOk3e9XH2"}],"key":"eXLR1NWodZ"}],"key":"Obbfi9rHSc"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":132,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Target Motif 1: 5’-GCA(N6)GTC-3’.","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"key":"avKluzRo1l"}],"key":"VNXwO2ZHMp"}],"key":"dNxdnw1a5n"},{"type":"listItem","spread":true,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Target Motif 2: 5’-GAA(N7)TGG-3’ (Secondary motif found in some ST8 variants).","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"bYfqa1DWnJ"}],"key":"rZn5Qoqthl"}],"key":"SeKZ1IktRg"},{"type":"listItem","spread":true,"position":{"start":{"line":134,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Note: USA300 also possesses a Type IV methyl-dependent restriction enzyme, SauUSI, which targets and cleaves DNA containing C5-methylcytosine (5mC). Your plasmid must be prepared in a dcm- E. coli strain to avoid these sites.","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"VguWVsotW1"}],"key":"hQau0S3d1E"}],"key":"Sbnb3BcOva"}],"key":"cZ5eCcio7Z"},{"type":"list","ordered":true,"start":2,"spread":false,"position":{"start":{"line":136,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":136,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":136,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"HG003 (CC8 / ST8) Recognition Motifs\nHG003 is a lab-optimized derivative of NCTC8325. Because it shares the CC8 lineage, its Type I RM recognition is identical to the USA300/ST8 pattern:\nTarget Motif: 5’-GCA(N6)GTC-3’.\nEngineering Fix: High-efficiency toolkits for HG003 often involve removing all five instances of this GCA(N6)GTC motif from the plasmid backbone.","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"VGUyW2FjIS"}],"key":"ja5NLeosj2"}],"key":"tZlgrRUYsc"},{"type":"listItem","spread":true,"position":{"start":{"line":141,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"Summary of Restrictions\nStrain / CC \tType I Motif (Sau1)\tType IV (SauUSI) Sensitivity\nUSA300 (CC8)\tGCA(N6)GTC\tYes (Avoid 5mC / Dcm+ E. coli)\nHG003 (CC8)\tGCA(N6)GTC\tYes (Avoid 5mC / Dcm+ E. coli)\nPractical Application: “Silencing” Your Vector\nScan for GCA(N6)GTC: Use a sequence analysis tool like the REBASE Scanning Tool to find these motifs in your CRISPR plasmid.\nMutate Sites: Change the sequence (e.g., GCA to GCT) at every occurrence.\nPropagate in dcm- Host: Use an E. coli strain like INV110 or ER2796 to ensure no cytosine methylation occurs.\nAlways confirm that the specific strain you are working with indeed has the expected restriction-modification system activity before beginning your experiments.","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"WK6hCSpm1h"}],"key":"ZzSB8nj7MZ"}],"key":"dNZ09yZ9Sx"}],"key":"By5K35pXpg"},{"type":"heading","depth":2,"position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"children":[{"type":"text","value":"Resources","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"key":"wE1mzBEP2i"}],"identifier":"resources","label":"Resources","html_id":"resources","implicit":true,"key":"lX9f1GjPCW"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":153,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"paragraph","childr