{"version":3,"kind":"Article","sha256":"9cfd5694b7e836f0a9cabfb683de0b0b2e1964d87563be8fb3f7a179bd3205ad","slug":"controls","location":"/02_Learn_Iseek/03_Physical_Computational_and_Applied_Sciences/Engineering/Nuclear/Controls.md","dependencies":[],"frontmatter":{"title":"Core System Classifications & Focus Areas","content_includes_title":true,"numbering":{"title":{"offset":4}},"exports":[{"format":"md","filename":"Controls.md","url":"/Documents/build/Controls-21e0d268e528fb00274a488cbda6c23e.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Advanced nuclear and highly regulated energy projects rely heavily on robust Instrumentation and Control (I&C) systems to ensure absolute safety, reliability, and regulatory compliance. A Controls Engineer operates as a senior-level technical expert, driving the system architecture from Front-End Engineering Design (FEED) through to final commissioning and procurement. [1, 2, 3]","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YUfzT1vrMI"}],"key":"QF9tcXobhB"},{"type":"heading","depth":1,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Core System Classifications & Focus Areas","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KuawdAYLxo"}],"identifier":"core-system-classifications-focus-areas","label":"Core System Classifications & Focus Areas","html_id":"core-system-classifications-focus-areas","implicit":true,"key":"RtJig1x0Ig"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"In advanced nuclear environments (including Light Water, Liquid Metal, and High-Temperature Gas Reactors), I&C design is strictly divided by safety significance: [3, 4]","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"verd0ki8li"}],"key":"TiekvL7oMF"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Safety-Related Systems (Safety Class 1 / SC1): Core reactor protection systems (RPS) and emergency core cooling systems (ECCS) designed to handle critical mitigation and safe shutdown. [1, 3, 4]","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"OHqhDq0b2i"}],"key":"WfE5xLidrd"}],"key":"pMom1tufbc"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Augmented Quality / Regulatory Treatment (RTNSS / SC2): Systems that are not strictly safety-related but provide a defensive layer or back up a critical safety function. [4]","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"VVyvE2XcEw"}],"key":"hANhZ4kth4"}],"key":"CDjZWmSJYv"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plant Investment Protection (PIP / SC3): Controls meant to safeguard expensive plant assets, preventing trips or hardware damage. [3, 4]","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"slFcThFNr9"}],"key":"LCm6XQuZq9"}],"key":"h651xGHBjN"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Balance of Plant (BOP): Non-safety-related secondary systems required for standard power generation and day-to-day operations. [2, 3, 4]","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"NLUteDJLNl"}],"key":"HRCpMH2v0G"}],"key":"cJDC3An34q"}],"key":"mgaMoFKpyz"},{"type":"heading","depth":1,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Essential Engineering Responsibilities","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"x3fDtHN5KA"}],"identifier":"essential-engineering-responsibilities","label":"Essential Engineering Responsibilities","html_id":"essential-engineering-responsibilities","implicit":true,"key":"yKazjspeeR"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":13,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Control Logic & Simulation: Apply control theory, mathematical modeling, and feedback loops to establish operating boundaries. Develop dynamic and logic-based simulation models. [1, 2, 3]","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"vaMj11bv3o"}],"key":"hPnJvweX27"}],"key":"B6pEGmH6zd"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Artifact & Diagram Creation: Produce and review highly complex structural engineering documents, including:","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"roTNI3PPvW"}],"key":"bYQndNxY5w"}],"key":"esIjovmJUR"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Functional block diagrams and sequential flow diagrams.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"Fia3Z67Bru"}],"key":"qnkNYxIMpk"},{"type":"list","ordered":false,"spread":false,"position":{"star