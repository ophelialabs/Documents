{"version":3,"kind":"Article","sha256":"9cfd5694b7e836f0a9cabfb683de0b0b2e1964d87563be8fb3f7a179bd3205ad","slug":"controls","location":"/02_Learn_Iseek/03_Physical_Computational_and_Applied_Sciences/Engineering/Nuclear/Controls.md","dependencies":[],"frontmatter":{"title":"Core System Classifications & Focus Areas","content_includes_title":true,"numbering":{"title":{"offset":4}},"exports":[{"format":"md","filename":"Controls.md","url":"/Documents/build/Controls-749d4a2da071162fffef90d38b122ec9.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Advanced nuclear and highly regulated energy projects rely heavily on robust Instrumentation and Control (I&C) systems to ensure absolute safety, reliability, and regulatory compliance. A Controls Engineer operates as a senior-level technical expert, driving the system architecture from Front-End Engineering Design (FEED) through to final commissioning and procurement. [1, 2, 3]","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jkLvVvciEg"}],"key":"PfgwI6dlXV"},{"type":"heading","depth":1,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Core System Classifications & Focus Areas","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Uw625nydbh"}],"identifier":"core-system-classifications-focus-areas","label":"Core System Classifications & Focus Areas","html_id":"core-system-classifications-focus-areas","implicit":true,"key":"Hz37GgLyON"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"In advanced nuclear environments (including Light Water, Liquid Metal, and High-Temperature Gas Reactors), I&C design is strictly divided by safety significance: [3, 4]","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"lYIz13kKU5"}],"key":"zw4S5UfimP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Safety-Related Systems (Safety Class 1 / SC1): Core reactor protection systems (RPS) and emergency core cooling systems (ECCS) designed to handle critical mitigation and safe shutdown. [1, 3, 4]","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"xNepLEzhXv"}],"key":"PsvAC0mnkc"}],"key":"b9DwuhcyyA"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Augmented Quality / Regulatory Treatment (RTNSS / SC2): Systems that are not strictly safety-related but provide a defensive layer or back up a critical safety function. [4]","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Y6A0BU49O4"}],"key":"fuE6p0GAHh"}],"key":"WYAUV18TM8"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plant Investment Protection (PIP / SC3): Controls meant to safeguard expensive plant assets, preventing trips or hardware damage. [3, 4]","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"cq70ex3gsv"}],"key":"wvDbvxdEup"}],"key":"YbXfSlQZXT"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Balance of Plant (BOP): Non-safety-related secondary systems required for standard power generation and day-to-day operations. [2, 3, 4]","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"bLYrgTmjxJ"}],"key":"kvYrKZBrTq"}],"key":"jx6dy8QhF4"}],"key":"w3mb8Q4FkH"},{"type":"heading","depth":1,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Essential Engineering Responsibilities","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"lPIUYalz4w"}],"identifier":"essential-engineering-responsibilities","label":"Essential Engineering Responsibilities","html_id":"essential-engineering-responsibilities","implicit":true,"key":"l6TdSCgGE7"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":13,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Control Logic & Simulation: Apply control theory, mathematical modeling, and feedback loops to establish operating boundaries. Develop dynamic and logic-based simulation models. [1, 2, 3]","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"NhqhMhy0qM"}],"key":"wP2jQ51jYV"}],"key":"OuJqRMEPL6"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Artifact & Diagram Creation: Produce and review highly complex structural engineering documents, including:","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Amj60WJ5Of"}],"key":"X0zLxKS2rg"}],"key":"f9NxETSGn2"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Functional block diagrams and sequential flow diagrams.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"mcht1EBRkg"}],"key":"rY7k3xJsLK"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":16,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Logic diagrams, ladder logic, and electrical schematics.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"kNr4Wu7Z5J"}],"key":"xFtN9oTeiY"}],"key":"JUbGUqP3wG"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Interconnection wiring arrangements and network architectures. [1, 2]","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"IDVC5NDt8f"}],"key":"ffmrmRjxrE"}],"key":"qFqV8yt9pV"}],"key":"rmZFP1wEKF"}],"key":"qCzYDKvUNI"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Requirements Management: Own the development and verification of hardware/software requirements, functional specifications, equipment sizing/selection, setpoint calculations, and error analyses. [2, 3, 5]","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"AJIhz7Xkw7"}],"key":"w0mJmvOw3j"}],"key":"JsZKF8WHsh"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Compliance & Lifecycle: Ensure all designs conform tightly to strict industry standards (such as IEC 60xxx, 61xxx, 62xxx series for nuclear application) and guide systems through rigorous configuration management protocols. [1]","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"svRegq1z3x"}],"key":"MpqrHtQkrz"}],"key":"qraIZxteoh"}],"key":"MpTE0Rh9fO"},{"type":"heading","depth":1,"position":{"start":{"line":21,"column":1