e discovery","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"vWMHi0PyPy"}],"key":"GeZjRfvtev"}],"key":"EZIuGVzgUq"}],"key":"QfYE2lb7YU"},{"type":"heading","depth":2,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Don’t Miss the Forest for the Trees","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"oCPjygKAPl"}],"identifier":"dont-miss-the-forest-for-the-trees","label":"Don’t Miss the Forest for the Trees","html_id":"dont-miss-the-forest-for-the-trees","implicit":true,"key":"hHad56j6m8"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"This knowledge base is meant to preserve the larger enterprise perspective. It is easy for teams to focus on local tasks, immediate project needs, or isolated implementation details. This repository exists to connect those details back to the bigger picture: how work fits into the organization’s strategy, platforms, systems, and long-term capability model.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"psSMS91SmZ"}],"key":"v5pe0hOjfe"},{"type":"heading","depth":3,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Entra ID","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"wbJTTUYtzp"}],"identifier":"entra-id","label":"Entra ID","html_id":"entra-id","implicit":true,"key":"UHwc2YPhdr"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Entra ID is the identity and access foundation for the enterprise knowledge ecosystem. It provides authentication, authorization, and lifecycle management for employees, partners, applications, services, and automation workflows.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"Cb6enRG98W"}],"key":"z8DHH9NXmI"},{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"Documentation in this area should capture:","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"kGiS85FWs5"}],"key":"jf5Dnh7Xbs"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":76,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tenant structure, verified domains, environments, and identity ownership","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"jUiYubf539"}],"key":"YU0P77x3ly"}],"key":"Sq985FKgkR"},{"type":"listItem","spread":true,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"User, group, and role-based access patterns for teams and shared resources","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"JxlwURk9eH"}],"key":"IGuQL4GCzN"}],"key":"Ty4J76sO5x"},{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Application registrations, service principals, managed identities, and API permissions","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"RbeKtjvIGn"}],"key":"Ol7i2HJPRm"}],"key":"lroEpDcTmk"},{"type":"listItem","spread":true,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Conditional Access, multifactor authentication, privileged access, and security boundaries","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"F9n7Aq3x8n"}],"key":"Bw5PNSiRcl"}],"k