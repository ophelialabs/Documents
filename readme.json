ent into clear, role-aware hubs for leadership, operations, engineering, research, and enterprise support without duplicating the source documentation.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"nW0JjkQO1Y"}],"key":"DyOHrZWZSr"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Each page or hub should have a defined audience, business purpose, content owner, review date, and canonical links back to the underlying knowledge base. Useful page types include:","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"F5QBcOjsIP"}],"key":"angeynRd2M"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":91,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Executive dashboards for strategy, decisions, risks, priorities, and organizational health","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"SLawJsG3tY"}],"key":"xNWg9aPqQU"}],"key":"TgQmazJXfa"},{"type":"listItem","spread":true,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Team and function hubs for responsibilities, contacts, procedures, systems, and current work","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"QN8Vv4L9du"}],"key":"sx8mUmBFWb"}],"key":"N5h8klpTe7"},{"type":"listItem","spread":true,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Engineering and platform portals for architecture, environments, APIs, deployments, and operational runbooks","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"VczUCQqEc