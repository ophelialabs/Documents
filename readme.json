"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"text","value":"Publishing and Governance","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"uLp9qRZugK"}],"identifier":"publishing-and-governance","label":"Publishing and Governance","html_id":"publishing-and-governance","implicit":true,"key":"jbdYJcCZKq"},{"type":"paragraph","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"Treat each Power Page as a managed product with an accountable owner and a lightweight release process:","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"KTvy829Q9x"}],"key":"ovWkmZuN9D"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":120,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define the audience, outcome, data classification, and success measure before implementation","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"PaZ9YjRSbY"}],"key":"XgOetefd7R"}],"key":"L5lNHwHHD1"},{"type":"listItem","spread":true,"position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Build and test changes in a non-production environment before publishing","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"wkpXgiYxw0"}],"key":"XaqSh5HhWe"}],"key":"s2javK5bgv"},{"type":"listItem","spread":true,"position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Review navigation, permissions, accessibility, links, and mobile behavior before release","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"hj9fwlurO