ce, or Langfuse.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"O8Iu5h9tX1"}],"key":"cxsW5JeYVU"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"These tools provide the tracing and visualization capabilities to map out complex, non-deterministic execution flows that are common in LLM applications built with LangChain and LangGraph. LangChain itself is a framework, not a dedicated monitoring or visualization platform.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"XhvqIjCRC5"}],"key":"pa03wedkSh"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Key Steps to Set Up User Path Tracing","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"vYSrbV3aHI"}],"identifier":"key-steps-to-set-up-user-path-tracing","label":"Key Steps to Set Up User Path Tracing","html_id":"key-steps-to-set-up-user-path-tracing","implicit":true,"key":"ZOTP4EsUiF"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Select an Observability Platform:","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"KrdILrANRc"}],"key":"EPQQRnuij2"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":11,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"LangSmith: The dedicated platform by LangChain for agent engineering, providing detailed tracing, monitoring, and evaluation.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"lGdRquaC2s"}],"key":"qamMqKFGTs"}],"key":"BhXIhlnTlk"},{"type":"listItem","spread":true,"position":{"start":{"l