ce, or Langfuse.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"zvGkURmCwE"}],"key":"MaMBwQM6Jc"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"These tools provide the tracing and visualization capabilities to map out complex, non-deterministic execution flows that are common in LLM applications built with LangChain and LangGraph. LangChain itself is a framework, not a dedicated monitoring or visualization platform.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"OQVccPnPeX"}],"key":"pzAECRhdE3"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Key Steps to Set Up User Path Tracing","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"ZpnC8gYXTP"}],"identifier":"key-steps-to-set-up-user-path-tracing","label":"Key Steps to Set Up User Path Tracing","html_id":"key-steps-to-set-up-user-path-tracing","implicit":true,"key":"DVNOg1BpW8"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Select an Observability Platform:","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"WtjGDHCvWm"}],"key":"WEMPsC6uN5"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":11,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"LangSmith: The dedicated platform by LangChain for agent engineering, providing detailed tracing, monitoring, and evaluation.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"HcBWZ0ZcJp"}],"key":"WQcqI4QFC6"}],"key":"WN4eEdVQco"},{"type":"listItem","spread":true,"position":{"start":{"l