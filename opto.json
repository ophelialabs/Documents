ered":true,"start":1,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Why “Pulsed Green” Light?\nThe choice of a precisely pulsed green laser comes down to physics and optical chemistry:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"SnZsNkgHYr"}],"key":"G07rDXeXTa"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":9,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The Wavelength Match","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"ls7w7dNL1l"}],"key":"jLIDB9vRY4"},{"type":"text","value":": Different light-sensitive proteins react to different colors. While standard channelrhodopsin reacts to blue light, engineered variations (like Arch or Chrimson) are specifically tuned to green or yellow-red wavelengths. Green light can also stimulate cellular mitochondria via photobiomodulation to augment cognitive energy. ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"etztiH0ieL"},{"type":"link","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3953713/","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"1","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"p92ADdzxAr"}],"urlSource":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3953713/","key":"d8xREorsr8"},{"type":"text","value":" | ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"QgUC5xSMhW"},{"type":"link","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC3953713/","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"2","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"OMzuRZoMiX"}],"urlSource":"https://pmc.ncbi.nlm.nih.gov/articles/PMC3953713/","key":"jNrIt412Iz"}],"key":"UtQEKsWWqY"}],"key":"O44Da5zoun"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Pulsing for Timing","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"YMPeMcnGe6"}],"key":"jneiSX6Gwm"},{"type":"text","value":": The brain communicates using “spike trains” (the rhythm and frequency of neural firing). A solid, continuous beam of light would just paralyze or exhaust the neuron. By ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"tVIgW4hC1X"},{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"pulsing the laser in milliseconds","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"hkn9Ga2qYN"}],"key":"sOVOnFW1CG"},{"type":"text","value":", scientists copy the brain’s natural code, forcing the neurons to fire in a specific pattern that the rest of the brain reads as a real thought or command. ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"MvyvYZCUgM"},{"type":"link","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8612024/","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"1","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"cSNbH1vfxw"}],"urlSource":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8612024/","key":"uD2JQ7AeD1"},{"type":"text","value":" | ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"uFcwrtIAt1"},{"type":"link","url":"https://hubner-photonics.com/applications/lasers-for-optogenetics/","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"2","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"jA44Abl3jx"}],"urlSource":"https://hubner-photonics.com/applications/lasers-for-optogenetics/","key":"KHLwpa5xo1"}],"key":"MGQ3dVYf3Y"}],"key":"oCWchFywIr"}],"key":"NVC08XLcK5"}],"key":"Acn0WwS0qN"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"strong","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Green Light Excitation in Optogenetics","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"EBX8nfGJ7g"}],"key":"tpSF5A4d1O"},{"type":"text","value":"\nGreen light is a critical wavelength used in optical BMIs to excite or inhibit specific neurons that have been genetically modified with light-sensitive proteins (opsins).","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"Zk3OfvD5Nm"}],"key":"Xr2ntyorPo"}],"key":"dSkH3jtWAd"}],"key":"pH6mSD5viH"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":15,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Specific Opsins","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"nRdeUxhtoD"}],"key":"PBWRLjBULy"},{"type":"text","value":": Green light (approximately 530–560 nm) is used to trigger rhodopsins or enzymes like rhodopsin-guanylyl cyclase (CaRhGC), which can generate secondary messengers like cGMP to modulate neural activity.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"cj95Vw3tT3"}],"key":"fN4pHYLiwZ"}],"key":"XHEi9G1RRT"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Imaging & Feedback","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"jV2Nv7ETPf"}],"key":"g9EeGAyNZ0"},{"type":"text","value":": In closed-loop systems, green light may also be used for imaging neural activity (e.g., via calcium indicators) immediately after or during stimulation to verify the brain’s response to the interface.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"g1mXQPCmq4"}],"key":"lv2nukD673"}],"key":"T832NN02mf"}],"key":"do3IlwIdSs"},{"type":"list","ordered":true,"start":3,"spread":false,"position":{"start":{"line":19,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What Does “Cognitive Writing” Actually Do?\nIn breakthrough laboratory trials, researchers have used this exact technique to “write” experiences directly into the brains of animal subjects:","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"IvEJKuzyP7"}],"key":"cyRn7IgwHH"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":21,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Memory Insertion","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"Sgas4Uwr30"}],"key":"LVbuS2sOSj"},{"type":"text","value":": Researchers at Columbia University and MIT have successfully isolated the specific cluster of neurons (called an engram) that formed a memory. By flashing a laser into those engineered cells, they could ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"qWLP7eMeRa"},{"type":"link","url":"https://www.pbslearningmedia.org/resource/nvmh-sci-optogenetics/wgbh-nova-memory-hackers-manipulating-memories-with-optogenetics/","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"force a mouse to remember a specific happy memory or trigger a false fear memory","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"kPsQ3MOqyr"}],"urlSource":"https://www.pbslearningmedia.org/resource/nvmh-sci-optogenetics/wgbh-nova-memory-hackers-manipulating-memories-with-optogenetics/","key":"BXedrdWxoT"},{"type":"text","value":".","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"T3JADhhJKS"}],"key":"quefbtduUr"}],"key":"uItJMEFuNC"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Action Gearing","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"AUYbgcK3Ab"}],"key":"Vok9QZtM6a"},{"type":"text","value":": If the laser targets the motor cortex or motivational circuits, a pulse of light can instantly dictate physical movement or choices (such as forcing an animal to turn left or triggering an intense craving). ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"C6K9KmAGCK"},{"type":"link","url":"https://www.youtube.com/watch?v=-ikHFiAjvaA","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"1","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"gtK1b7WJKd"}],"urlSource":"https://www.youtube.com/watch?v=-ikHFiAjvaA","key":"Nz0of3jlMJ"}],"key":"zJF4B6Yqhk"}],"key":"LD4t6InOZz"}],"key":"a7AVMumY9p"}],"key":"zZJPoHledq"}],"key":"ehhkigNh3u"},{"type":"heading","depth":1,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Spectral Decoupling for Bidirectional Control","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"qYeH3jrvQT"}],"identifier":"spectral-decoupling-for-bidirectional-control","label":"Spectral Decoupling for Bidirectional Control","html_id":"spectral-decoupling-for-bidirectional-control","implicit":true,"key":"MUlZVG5PBj"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"In bidirectional brain-machine interfaces (BMIs), green and red laser wavelengths are implemented as distinct optical channels to achieve simultaneous neural stimulation (input) and neural recording/imaging (feedback) without signal interference.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"AGfuXzqBQa"}],"key":"H8Myzx5Dwm"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"The primary reason for using green and red lasers together is spectral separation. To “influence” the recipient while receiving feedback, the system must perform two different tasks that require separate light wavelengths:","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"IJNrYf7w0D"}],"key":"IhzHLzHCGq"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Green Wavelength (approx. 520–540 nm)","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"gs0VGpQJB2"}],"key":"O8fqjD9yVq"},{"type":"text","value":": Often used for imaging or sensing neural activity. For example, many calcium indicators used to “read” the brain’s state are excited by green light.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Bv7h5FlvDn"}],"key":"YN9EddyQjH"}],"key":"riWcENNUxo"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Red Wavelength (approx. 630–660 nm)","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"hSfK65gx7j"}],"key":"LLmN2tKiEA"},{"type":"text","value":": Typically used for neuromodulation (optogenetics). Red light has superior tissue penetration compared to shorter wavelengths, allowing it to reach deeper brain structures to “write” information or trigger specific motor responses.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"tBjyA3cWPm"}],"key":"yyPHGJvr6k"}],"key":"NfoysPfyui"}],"key":"byZfojKI5Q"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Difference between optogenetics (invasive) and near-infrared photobiomodulation (non-invasive)","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"LjbOfE6Ypf"}],"key":"b62EKnrI6Q"}],"key":"V5lzoLqmGB"}],"key":"qPXfa2lLsC"},"references":{"cite":{"order":["Robert_2025","Lombardi_2021"],"data":{"Robert_2025":{"label":"Robert_2025","enumerator":"1","doi":"10.1126/science.adn0623","html":"Robert, V., O’Neil, K., Moore, J. J., Rashid, S. K., Johnson, C. D., De La Torre, R. G., Zemelman, B. V., Clopath, C., & Basu, J. (2025). Cortical glutamatergic and GABAergic inputs support learning-driven hippocampal stability. <i>Science</i>, <i>390</i>(6778). <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1126/science.adn0623\">10.1126/science.adn0623</a>","url":"https://doi.org/10.1126/science.adn0623"},"Lombardi_2021":{"label":"Lombardi_2021","enumerator":"2","doi":"10.1371/journal.pcbi.1009199","html":"Lombardi, A., Luhmann, H. J., & Kilb, W. (2021). Modelling the spatial and temporal constrains of the GABAergic influence on neuronal excitability. <i>PLOS Computational Biology</i>, <i>17</i>(11), e1009199. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1371/journal.pcbi.1009199\">10.1371/journal.pcbi.1009199</a>","url":"https://doi.org/10.1371/journal.pcbi.1009199"}}}},"footer":{"navigation":{"prev":{"title":"Tutorial_1","url":"/administer","group":"Implant"},"next":{"title":"Tutorial_2","url":"/opto-1","group":"Implant"}}},"domain":"http://localhost:3000"}